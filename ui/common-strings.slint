// Shared interface vocabulary. Keep generic actions here so they have one
// translation context instead of being duplicated by every consuming screen.
export global CommonStrings {
    out property <string> pause: @tr("Pause");
    out property <string> resume: @tr("Resume");
    out property <string> cancel: @tr("Cancel");
    out property <string> save: @tr("Save");
    out property <string> delete: @tr("Delete");
}
