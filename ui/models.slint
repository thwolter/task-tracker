export enum Page { home, first-run, tracking, note, adjust-time, settings, project-editor, evaluation, drilldown, exportpage }
export enum Range { day, week, month, year }
export enum StatusKind { success, error }
export enum ExportFormat { csv, markdown, json }

export struct Status {
    message: string,
    kind: StatusKind,
}

export struct ProjectItem {
    id: string,
    name: string,
    completed: bool,
    archived: bool,
}

export struct TrackingState {
    active-project-id: string,
    active-task: string,
    elapsed: string,
    paused: bool,
    secondary-active: bool,
}

export struct TaskItem {
    id: string,
    project: string,
    note: string,
    duration-seconds: int,
    timestamp: string,
    started-time: string,
    finished-time: string,
}

// A transient draft for the focused time-correction workflow. The task id,
// rather than a display label or row position, keeps the eventual mutation
// bound to the completed task that opened this editor.
export struct AdjustTimeState {
    task-id: string,
    project: string,
    day-label: string,
    started-time: string,
    finished-time: string,
    error: string,
}

export struct EvaluationTaskItem {
    id: string,
    project: string,
    note: string,
    duration-seconds: int,
    completed-label: string,
}

export struct HomeState {
    projects: [ProjectItem],
    last-task: TaskItem,
    has-last-task: bool,
}

export struct ProjectTotalItem {
    id: string,
    project: string,
    duration-seconds: int,
    num_tasks: int,
}

export struct EvaluationState {
    tasks: [EvaluationTaskItem],
    total-seconds: int,
    range: Range,
    project-totals: [ProjectTotalItem]
}

export struct EvaluationTasksState {
    project: string,
    tasks: [EvaluationTaskItem],
    total-seconds: int,
    range: Range,
}

export struct ExportState {
    project: string,
    all-projects: bool,
    return-page: Page,
}

// A single mode prevents create/edit/delete states from overlapping.
export enum ProjectEditorMode { create, edit, confirm-delete }
export struct ProjectEditorState {
    mode: ProjectEditorMode,
    project: ProjectItem,
    draft-name: string,
    error: string,
}
export struct ProjectSettingsState {
    active: [ProjectItem],
    archived: [ProjectItem],
}

// The onboarding owns only transient UI state. The controller owns the
// persisted project and decides when navigation can advance.
export enum FirstRunPhase { create-first, choose-next, add-another }
export struct FirstRunState {
    phase: FirstRunPhase,
    draft-name: string,
    created-projects: [ProjectItem],
    error: string,
}
