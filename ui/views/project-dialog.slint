import { LineEdit } from "std-widgets.slint";
import { AppButton } from "../components/app-button.slint";
import { BackLink } from "../components/back-link.slint";
import { Theme } from "../theme.slint";
import { BodyText, TitleText, TextLink } from "../components/typography.slint";
import { AppActions } from "../actions.slint";

component ProjectSettingBox inherits VerticalLayout {
    in-out property <string> project;
    in property <bool> is-project;

    callback accepted(string);

    spacing: 20px;

    TitleText {
	    text: root.is-project ? root.project : @tr("New project");
	    }

    BodyText {
        text: @tr("Keep the name clear and easy to spot in your timer.");
        wrap: word-wrap;
    }

    Rectangle {
        height: 42px;
        background: Theme.palette.surface;

		HorizontalLayout {
			padding: 10px;

			task-input := TextInput {
                vertical-alignment: center;
                single-line: true;
                width: 100%;
                font-size: Theme.typography.body.size;

                accepted => { root.accepted(root.project); }
                text <=> root.project;
            }
		}
    }

	HorizontalLayout {
		spacing: 20px;
		alignment: end;

        AppButton {
            width: 140px;
            height: 40px;
            label: @tr("Save name");
            prefix-icon: @image-url("../assets/icons/check.svg");
            inactive: (root.project == "");
            clicked => { root.accepted(root.project); }
        }
	}

	VerticalLayout {
		Rectangle {}

        Rectangle {
            height: 1px;
            background: Theme.palette.section-divider;
        }
    }
}

component ArchiveBox inherits VerticalLayout {

	callback clicked();

	spacing: 10px;
	padding-bottom: 20px;

	TitleText {
        text: @tr("Archive project");
    }

    BodyText {
        text: @tr("Removes it from your task list. Your past time entries stay in Evaluation.");
        wrap: word-wrap;
        vertical-alignment: center;
    }

	HorizontalLayout {
		alignment: start;
		TouchArea {
			mouse-cursor: pointer;
			clicked => { root.clicked(); }
			Text {
				text: @tr("Archive project");
				color: Theme.palette.danger;
				font-size: Theme.typography.body.size;
			}
		}
	}
}

component UnarchiveBox inherits VerticalLayout {

    in property <string> project;

    callback unarchive();
    callback delete();

    spacing: 20px;
    padding-bottom: 20px;

    TitleText {
        text: project;
    }

    BodyText {
        text: @tr("This project is hidden from Home. Its past time entries remain in Evaluation.");
        wrap: word-wrap;
        vertical-alignment: center;
    }

    AppButton {
        width: 180%;
        label: @tr("Unarchive");
        background: Theme.palette.accent-surface;
        border-color: Theme.palette.accent;
        border-width: 1px;
        label-color: Theme.palette.accent;
        clicked => { root.unarchive(); }
    }

    TextLink {
		text: @tr("Delete finally");
		color: Theme.palette.danger;
		horizontal-alignment: center;

		clicked => { root.delete(); }
    }

    Rectangle {}
}

export component ProjectDialog inherits Rectangle {
    in property <bool> rename-mode;
    in property <string> initial-draft;
    in property <string> project-id;
    in property <bool> archived;

    property <string> project: root.initial-draft;
    private property <bool> is-project: root.project-id != "";

    background: Theme.palette.soft-surface;

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

		BackLink {
            text: @tr("Project settings");
            clicked => { AppActions.close-project-dialog(); }

        }

		VerticalLayout {
			spacing: 20px;

			if (!root.archived): ProjectSettingBox {
				accepted => { AppActions.save-project(root.project); }
				project <=> root.project;
				is-project: root.is-project;
			}

			if (root.is-project && !root.archived): ArchiveBox {
				clicked => { AppActions.archive-project(root.project-id); }
			}

			if (root.is-project && root.archived): UnarchiveBox {
				project: root.project;
				unarchive => { AppActions.unarchive-project(root.project-id); }
				delete => { AppActions.delete-project(root.project-id); }
			}
		}
    }
}
