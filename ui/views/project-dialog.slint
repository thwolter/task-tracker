import { LineEdit } from "std-widgets.slint";
import { AppButton } from "../components/app-button.slint";
import { BackLink } from "../components/back-link.slint";
import { Theme } from "../theme.slint";
import { BodyText, TitleText } from "../components/typography.slint";

component ProjectSettingBox inherits VerticalLayout {
    in-out property <string> project;
    in property <bool> is-project;

    callback accepted(string);

    spacing: 20px;

    TitleText {
    text: root.is-project ? root.project : "New project";
    }

    BodyText {
        text: "Keep the name clear and easy to spot in your timer.";
        wrap: word-wrap;
    }

    Rectangle {
        height: 42px;
        background: Theme.palette.surface;

		HorizontalLayout {
			padding: 10px;

			task-input := TextInput {
                vertical-alignment: center;
                single-line: true;
                width: 100%;
                font-size: Theme.typography.body.size;

                accepted => { root.accepted(root.project); }
                text <=> root.project;
            }
		}
    }

	HorizontalLayout {
		spacing: 20px;
		alignment: end;

        AppButton {
            width: 140px;
            height: 40px;
            label: "Save name";
            prefix-icon: @image-url("../assets/icons/check.svg");
            clicked => { root.accepted(root.project); }
        }
	}

	VerticalLayout {
		Rectangle {}

        Rectangle {
            height: 1px;
            background: Theme.palette.section-divider;
        }
    }
}

component ArchiveBox inherits VerticalLayout {
	spacing: 10px;
	padding-bottom: 20px;

	callback clicked();

	TitleText {
        text: "Archive project";
    }

    BodyText {
        text: "Removes it from your task list. Your past time entries stay in Evaluation.";
        wrap: word-wrap;
        vertical-alignment: center;
    }

	HorizontalLayout {
		alignment: start;
		TouchArea {
			mouse-cursor: pointer;
			clicked => { root.clicked(); }
			Text {
				text: "Archive project";
				color: Theme.palette.danger;
				font-size: Theme.typography.body.size;
			}
		}
	}
}

component UnarchiveBox inherits VerticalLayout {
    spacing: 20px;
    padding-bottom: 20px;

    callback clicked();

    TitleText {
        text: "Archived project";
    }

    BodyText {
        text: "This project is hidden from Home. Its past time entries remain in Evaluation.";
        wrap: word-wrap;
        vertical-alignment: center;
    }

    TouchArea {
        width: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        AppButton {
            label: "Unarchive project";
        }
    }

    Rectangle {}
}

export component ProjectDialog inherits Rectangle {
    in property <bool> rename-mode;
    in property <string> initial-draft;
    in property <string> project-id;
    in property <bool> archived;

    property <string> project: root.initial-draft;
    private property <bool> is-project: root.project-id != "";

    callback close();
    callback save(string);
    callback archive(string);
    callback unarchive(string);

    background: Theme.palette.soft-surface;

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

		BackLink {
            text: "Project settings";
            clicked => { root.close(); }

        }

		if (root.is-project && !root.archived): VerticalLayout {
			spacing: 20px;

			ProjectSettingBox {
				accepted => { root.save(root.project); }
				project <=> root.project;
				is-project: root.is-project;
			}
			ArchiveBox {
				clicked => { root.archive(root.project-id); }
			}
		}

		if (root.is-project && root.archived): UnarchiveBox {
			clicked => { root.unarchive(root.project-id); }
		}

    }
}
