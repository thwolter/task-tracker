import { AppButton } from "../components/app-button.slint";
import { ViewHeader } from "../components/typography.slint";
import {
    EvaluationTasksState,
    EvaluationTaskItem,
} from "../models.slint";
import { AppActions } from "../actions.slint";
import { Theme } from "../theme.slint";
import { BackLink } from "../components/back-link.slint";
import { ScrollableColumn } from "../components/scrollable-column.slint";
import { DurationLabel } from "../components/duration-label.slint";
import { EvaluationSummary } from "../components/evaluation-summary.slint";
import { RangeList } from "../components/range-list.slint";
import { IconButton } from "../components/icon-button.slint";
import { ScrollView } from "std-widgets.slint";

component TaskTimelineMarker inherits Rectangle {
    Rectangle {
        x: 4px;
        width: 2px;
        height: parent.height;
        background: Theme.border-subtle;
    }

    Rectangle {
        y: 7px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.action-primary;
    }
}

component TaksCardButtons inherits Rectangle {
    in property <bool> editing;

    callback edit();
    callback save();
    callback delete();

    if (!root.editing): HorizontalLayout {
        spacing: 8px;
        alignment: end;

        IconButton {
            icon: @image-url("../assets/icons/edit.svg");
            icon-color: Theme.action-primary;
            clicked => { root.edit(); }
        }

        IconButton {
            icon: @image-url("../assets/icons/delete.svg");
            icon-color: Theme.action-danger;
            clicked => { root.delete(); }
        }
    }

    if (root.editing): HorizontalLayout {
        alignment: start;
        padding-left: 5px;
        IconButton {
            icon: @image-url("../assets/icons/check.svg");
            icon-color: Theme.action-primary;
            clicked => {
                root.save();
            }
        }
    }
}

component TaskNoteContent inherits VerticalLayout {
    in property <bool> editing;
    in property <string> note;

    in-out property <string> draft;

    callback save(string);

    vertical-stretch: 0;
    alignment: start;

    if (!root.editing): Rectangle {

        height: description.preferred-height;

        description := Text {
            x: 0px;
            width: 120px;
            height: 100%;
            text: note == "" ? @tr("No details added") : root.note;
            color: Theme.content-primary;
            font-size: Theme.typography.body.size;
            font-weight: Theme.typography.body.weight;
            wrap: word-wrap;
            horizontal-alignment: left;
            vertical-alignment: top;
            horizontal-stretch: 0;
        }
    }

    if (root.editing): Rectangle {
        height: max(34px, description-input.preferred-height + 10px);
        background: Theme.surface-card;
        border-color: Theme.border-focus;
        border-width: 1px;

        description-input := HorizontalLayout {
            padding: 5px;
            TextInput {
                width: 100%;
                height: self.preferred-height;
                single-line: false;
                wrap: word-wrap;
                font-size: Theme.typography.body.size;
                font-weight: Theme.typography.body.weight;
                color: Theme.content-primary;
                text <=> root.draft;
                accepted => {
                    root.save(root.draft);
                }
            }
        }
    }
}

export component TaskCard inherits Rectangle {
    in property <EvaluationTaskItem> entry;
    in property <bool> editing;
    in-out property <string> description-draft;

    callback edit-requested(string, string);
    callback save-requested(string, string);
    callback delete-task(string);

    min-width: 0px;

    HorizontalLayout {
        spacing: 12px;

        TaskTimelineMarker {
            width: 10px;
        }

        Rectangle {
            HorizontalLayout {
                padding-top: 5px;
                padding-bottom: 10px;

                VerticalLayout {
                    alignment: start;
                    spacing: 5px;

                    Text {
                        text: root.entry.completed-label;
                        color: Theme.content-secondary;
                        font-size: Theme.typography.caption.size;
                        font-weight: Theme.typography.caption.weight;
                    }

                    TaskNoteContent {
                        note: root.entry.note;
                        editing: root.editing;

                        draft <=> root.description-draft;
                        save(draft) => { root.save-requested(root.entry.id, root.description-draft); }
                    }
                }

                // Duration label and edit/delte buttons
                VerticalLayout {
                    Text {
                        width: 70px;
                        text: duration.text;
                        color: Theme.action-primary;
                        font-size: Theme.typography.supporting.size;
                        font-weight: Theme.typography.supporting.weight;
                        horizontal-alignment: right;
                    }

                    TaksCardButtons {
                        editing: root.editing;
                        edit => { root.edit-requested(root.entry.id, root.entry.note); }
                        save => { root.save-requested(root.entry.id, root.description-draft); }
                        delete => { root.delete-task(root.entry.id); }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.border-divider;
            }

            duration := DurationLabel {
                seconds: root.entry.duration-seconds;
            }
        }
    }
}

export component DrilldownView inherits Rectangle {
    in property <EvaluationTasksState> state;
    private property <string> editing-task-id: "";
    private property <string> description-draft: "";

    callback open-evaluation-view();

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        BackLink {
            text: @tr("Projects");
            clicked => { root.open-evaluation-view(); }
        }

        ViewHeader {
            text: root.state.project;
        }

        RangeList {
            range: root.state.range;
            clicked(range) => { AppActions.choose-range(range); }
        }

        EvaluationSummary {
            total-seconds: root.state.total-seconds;
            range: root.state.range;
            vertical-stretch: 0;
        }

        Text {
            text: state.tasks.length == 1
                ? @tr("1 completed task")
                : state.tasks.length + " " + @tr("completed tasks");
            color: Theme.content-muted;
            font-size: Theme.typography.caption.size;
            font-weight: Theme.typography.caption.weight;
        }

        ScrollView {
            min-height: 0px;
            preferred-height: task-list.preferred-height;
            vertical-stretch: 1;
            max-height: task-list.preferred-height;
            task-list := VerticalLayout {
                width: 100%;
                vertical-stretch: 0;

                for task in root.state.tasks: TaskCard {
                    entry: task;
                    editing: root.editing-task-id == task.id;
                    description-draft <=> root.description-draft;
                    edit-requested(id, note) => {
                        root.editing-task-id = id;
                        root.description-draft = note;
                    }
                    save-requested(id, note) => {
                        AppActions.update-evaluation-task(id, note);
                        root.editing-task-id = "";
                    }
                    delete-task(id) => { AppActions.delete-evaluation-task(id); }
                }
            }
        }

        VerticalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            Rectangle {
                min-height: 0px;
                preferred-height: 0px;
                vertical-stretch: 1;
            }

            AppButton {
                label: @tr("Export Markdown");
                prefix-icon: @image-url("../assets/icons/download.svg");
                primary: true;
                clicked => { AppActions.export-markdown(); }
            }
        }
    }
}
