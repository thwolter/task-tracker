import { AppButton } from "../components/app-button.slint";
import { ViewHeader, TextLink } from "../components/typography.slint";
import {
    EvaluationTasksState,
    Page,
    EvaluationTaskItem,
} from "../models.slint";
import { AppActions } from "../actions.slint";
import { Theme } from "../theme.slint";
import { BackLink } from "../components/back-link.slint";
import { ScrollableColumn } from "../components/scrollable-column.slint";
import { DurationLabel } from "../components/duration-label.slint";
import { EvaluationSummary } from "../components/evaluation-summary.slint";
import { RangeList } from "../components/range-list.slint";
import { IconButton } from "../components/icon-button.slint";
import { ScrollView, HorizontalBox } from "std-widgets.slint";
import { TextEdit } from "../components/text-edit.slint";

component TaskTimelineMarker inherits Rectangle {
    Rectangle {
        x: 4px;
        width: 2px;
        height: parent.height;
        background: Theme.border-subtle;
    }

    Rectangle {
        y: 7px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.action-primary;
    }
}

component TaskEditor inherits HorizontalLayout {
    in property <EvaluationTaskItem> entry;

    callback cancel();

    VerticalLayout {
        width: 100%;
        spacing: 10px;

        TextEdit {
            placeholder: root.entry.note;
        }
        HorizontalLayout {
            alignment: space-between;
            cross-axis-alignment: center;

            IconButton {
                icon: @image-url("../assets/icons/delete.svg");
                icon-color: Theme.action-danger;
                background: Theme.surface-card;
            }
            HorizontalLayout {
                spacing: 10px;

                AppButton {
                    label: @tr("Cancel");
                    primary: false;
                    clicked => { cancel(); }
                }
                AppButton {
                    label: @tr("Save");
                }
            }

        }
    }

}

export component TaskCard inherits Rectangle {
    in property <EvaluationTaskItem> entry;
    in-out property <string> description-draft;
    private property <bool> editing;

    callback edit(EvaluationTaskItem);
    callback save-requested(string, string);
    callback delete-task(string);

    HorizontalLayout {
        width: 100%;
        spacing: 12px;

        TaskTimelineMarker {
            width: 10px;
        }

        Rectangle {
            horizontal-stretch: 1;
            max-width: parent.width;
            HorizontalLayout {
                padding-top: 5px;
                padding-bottom: 10px;
                cross-axis-alignment: center;

                VerticalLayout {
                    width: 100%;
                    alignment: start;
                    spacing: 5px;

                    Text {
                        text: root.entry.completed-label;
                        color: Theme.content-secondary;
                        font-size: Theme.typography.caption.size;
                        font-weight: Theme.typography.caption.weight;
                    }

                    if (!root.editing): Rectangle {
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.editing = true; }
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            cross-axis-alignment: start;

                            Text {
                                height: 100%;
                                text: root.entry.note == "" ? @tr("No details added") : root.entry.note;
                                color: Theme.content-primary;
                                font-size: Theme.typography.body.size;
                                font-weight: Theme.typography.body.weight;
                                wrap: word-wrap;
                                horizontal-alignment: left;
                                vertical-alignment: top;
                                horizontal-stretch: 0;
                            }
                            Image {
                                source: @image-url("../assets/icons/edit.svg");
                                width: 18px;
                            }
                        }
			        }

                    if (root.editing): TaskEditor {
			            entry: root.entry;
			            cancel => { root.editing = false;}
			        }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.border-divider;
            }

            duration := DurationLabel {
                seconds: root.entry.duration-seconds;
            }
        }
    }
}

export component DrilldownView inherits Rectangle {
    in property <EvaluationTasksState> state;

    private property <EvaluationTaskItem> active-task;
    private property <bool> editing: false;
    private property <string> description-draft: "";

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        BackLink {
            text: @tr("Projects");
            clicked => { AppActions.navigate(Page.evaluation); }
        }

        ViewHeader {
            text: root.state.project;
        }

        RangeList {
            range: root.state.range;
            clicked(range) => { AppActions.choose-range(range); }
        }

        EvaluationSummary {
            total-seconds: root.state.total-seconds;
            range: root.state.range;
            vertical-stretch: 0;
        }

        Text {
            text: state.tasks.length == 1
                ? @tr("1 completed task")
                : state.tasks.length + " " + @tr("completed tasks");
            color: Theme.content-muted;
            font-size: Theme.typography.caption.size;
            font-weight: Theme.typography.caption.weight;
        }

        ScrollView {
            min-height: 0px;
            preferred-height: task-list.preferred-height;
            vertical-stretch: 1;
            max-height: task-list.preferred-height;
            task-list := VerticalLayout {
                width: 100%;
                vertical-stretch: 0;

                for task in root.state.tasks: TaskCard {
                    entry: task;
                    /*description-draft <=> root.description-draft;
                    edit(task) => {
                        root.active-task = task;
                        root.editing = true;
                        root.description-draft = task.note;
                    }
                    save-requested(id, note) => {
                        AppActions.update-evaluation-task(id, note);
                        root.editing-task-id = "";
                    }
                    delete-task(id) => { AppActions.delete-evaluation-task(id); }
                    */
                }
            }
        }

        VerticalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            Rectangle {
                min-height: 0px;
                preferred-height: 0px;
                vertical-stretch: 1;
            }

            AppButton {
                label: @tr("Export Markdown");
                prefix-icon: @image-url("../assets/icons/download.svg");
                primary: true;
                clicked => { AppActions.export-markdown(); }
            }
        }
    }
}
