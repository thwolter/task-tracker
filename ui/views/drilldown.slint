import { AppButton, AppButtonIntent, AppButtonVariant } from "../components/app-button.slint";
import { ViewHeader, TextLink, LabelText, BodyText } from "../components/typography.slint";
import {
    EvaluationTasksState,
    Page,
    EvaluationTaskItem,
} from "../models.slint";
import { AppActions } from "../actions.slint";
import { Theme } from "../theme.slint";
import { BackLink } from "../components/back-link.slint";
import { ScrollableColumn } from "../components/scrollable-column.slint";
import { DurationLabel } from "../components/duration-label.slint";
import { EvaluationSummary } from "../components/evaluation-summary.slint";
import { RangeList } from "../components/range-list.slint";
import { IconButton, IconButtonIntent } from "../components/icon-button.slint";
import { DeleteConfirmation } from "../components/delete-confirmation.slint";
import { ScrollView, HorizontalBox } from "std-widgets.slint";
import { TextEdit } from "../components/text-edit.slint";

component TaskTimelineMarker inherits Rectangle {
    in property <length> line-height;

    Rectangle {
        x: 4px;
        width: 2px;
        height: root.line-height;
        background: Theme.border-subtle;
    }

    Rectangle {
        y: 7px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.action-primary;
    }
}

component TaskEditor inherits HorizontalLayout {
    in property <EvaluationTaskItem> entry;
    in-out property <string> draft-note: entry.note;

    callback cancel();
    callback save(string, string);
    callback delete(EvaluationTaskItem);


    VerticalLayout {
        width: 100%;
        spacing: 10px;

        TextEdit {
            placeholder: root.draft-note == ""
                ? @tr("e.g. prepared the Q4 project brief")
                : root.entry.note;
            text <=> root.draft-note;
        }
        HorizontalLayout {
            alignment: space-between;
            cross-axis-alignment: center;

            IconButton {
                icon: @image-url("../assets/icons/delete.svg");
                intent: IconButtonIntent.danger;
                has-background: false;
                clicked => { root.delete(root.entry); }
            }
            HorizontalLayout {
                spacing: 10px;

                AppButton {
                    label: @tr("Cancel");
                    intent: AppButtonIntent.secondary;
                    variant: AppButtonVariant.outline;
                    clicked => { cancel(); }
                }
                AppButton {
                    prefix-icon: @image-url("../assets/icons/check.svg");
                    label: @tr("Save");
                    clicked => { root.save(root.entry.id, root.draft-note); }
                }
            }

        }
    }

}

export component TaskCard inherits Rectangle {
    in property <EvaluationTaskItem> entry;
    private property <bool> editing;

    // Cards retain their content height; the footer spacer absorbs any surplus.
    vertical-stretch: 0;
    height: card-content.preferred-height;

    callback edit(EvaluationTaskItem);
    callback delete(EvaluationTaskItem);

    card-content := HorizontalLayout {
        width: 100%;
        spacing: 12px;

        TaskTimelineMarker {
            width: 10px;
            height: 40px;
            line-height: root.height;
        }

        Rectangle {
            horizontal-stretch: 1;
            max-width: parent.width;
            HorizontalLayout {
                padding-top: 5px;
                padding-bottom: 10px;
                cross-axis-alignment: center;

                VerticalLayout {
                    width: 100%;
                    alignment: start;
                    spacing: 5px;

                    Text {
                        text: root.entry.completed-label;
                        color: Theme.content-secondary;
                        font-size: Theme.typography.caption.size;
                        font-weight: Theme.typography.caption.weight;
                    }

                    if (!root.editing): Rectangle {
                        height: description.preferred-height > 18px
                            ? description.preferred-height : 18px;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.editing = true; }
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            cross-axis-alignment: center;

                            description := Text {
                                text: root.entry.note == "" ? @tr("No details added") : root.entry.note;
                                color: Theme.content-primary;
                                font-size: Theme.typography.body.size;
                                font-weight: Theme.typography.body.weight;
                                wrap: word-wrap;
                                horizontal-alignment: left;
                                vertical-alignment: top;
                                horizontal-stretch: 0;
                            }
                            IconButton {
                                icon: @image-url("../assets/icons/edit.svg");
                                has-background: false;
                                clicked => { root.editing = true; }
                            }
                        }
			        }

                    if (root.editing): TaskEditor {
			            entry: root.entry;
			            
			            cancel => { root.editing = false;}
			            delete(task) => { root.delete(task); }
			            save(id, draft-note) => {
			                AppActions.update-evaluation-task(id, draft-note);
			                root.editing = false;
			            }
			        }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.border-divider;
            }

            duration := DurationLabel {
                seconds: root.entry.duration-seconds;
            }
        }
    }
}

export component DrilldownView inherits Rectangle {
    in property <EvaluationTasksState> state;

    private property <EvaluationTaskItem> active-task;
    private property <bool> editing: false;
    private property <string> description-draft: "";
    private property <EvaluationTaskItem> pending-delete: {
        id: "",
        project: "",
        note: "",
        duration-seconds: 0,
        completed-label: "",
    };
    private property <bool> confirming-delete: root.pending-delete.id != "";

    function cancel-delete() {
        root.pending-delete = {
            id: "",
            project: "",
            note: "",
            duration-seconds: 0,
            completed-label: "",
        };
    }

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        BackLink {
            text: @tr("Evaluation");
            clicked => { AppActions.navigate(Page.evaluation); }
        }

        ViewHeader {
            text: root.state.project;
        }

        RangeList {
            range: root.state.range;
            clicked(range) => { AppActions.choose-range(range); }
        }

        EvaluationSummary {
            total-seconds: root.state.total-seconds;
            range: root.state.range;
            vertical-stretch: 0;
        }

        Text {
            text: state.tasks.length == 1
                ? @tr("1 completed task")
                : state.tasks.length + " " + @tr("completed tasks");
            color: Theme.content-muted;
            font-size: Theme.typography.caption.size;
            font-weight: Theme.typography.caption.weight;
        }

        ScrollView {
            min-height: 0px;
            preferred-height: task-list.preferred-height;
            vertical-stretch: 0;
            max-height: task-list.preferred-height;
            task-list := VerticalLayout {
                width: 100%;
                vertical-stretch: 0;
                alignment: start;

                for task in root.state.tasks: TaskCard {
                    entry: task;
                    delete(task) => { root.pending-delete = task; }
                }
            }
        }

        VerticalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            Rectangle {
                min-height: 0px;
                preferred-height: 0px;
                vertical-stretch: 1;
            }

            AppButton {
                width: parent.width;
                label: @tr("Export");
                prefix-icon: @image-url("../assets/icons/download.svg");
                clicked => { AppActions.open-export(); }
            }
        }
    }

    if (root.confirming-delete): DeleteConfirmation {
        private property <EvaluationTaskItem> task: root.pending-delete;

        Text {
			text: @tr("Delete permanently?");
			color: Theme.action-danger;
			font-size: Theme.typography.title.size;
			font-weight: Theme.typography.title.weight;
		}
		VerticalLayout {
			spacing: 10px;
			padding-top: 10px;

            LabelText {
	            text: task.completed-label;
	            color: Theme.content-secondary;
	            wrap: word-wrap;
	        }
	        BodyText {
	            text: task.note == "" ? "[No description]" : task.note;
	            color: Theme.content-primary;
	            wrap: word-wrap;
	        }
        }

        canceled => { root.cancel-delete(); }
        confirmed => {
            AppActions.delete-evaluation-task(root.pending-delete.id);
            root.cancel-delete();
        }
    }
}
