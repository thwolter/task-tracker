import { AppButton } from "../components/app-button.slint";
import { ViewHeader } from "../components/typography.slint";
import {
    EvaluationTasksState,
    EvaluationTaskItem,
    Range,
} from "../models.slint";
import { Theme } from "../theme.slint";
import { BackLink } from "../components/back-link.slint";
import { ScrollableColumn } from "../components/scrollable-column.slint";
import { DurationLabel } from "../components/duration-label.slint";
import { EvaluationSummary } from "../components/evaluation-summary.slint";
import { RangeList } from "../components/range-list.slint";
import { IconButton } from "../components/icon-button.slint";
import { ScrollView, Button } from "std-widgets.slint";

component TaskTimelineMarker inherits Rectangle {
    Rectangle {
        x: 4px;
        width: 2px;
        height: parent.height;
        background: Theme.palette.soft-border;
    }

    Rectangle {
        y: 7px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.palette.accent;
    }
}

export component TaskCard inherits Rectangle {
    in property <EvaluationTaskItem> entry;
    in property <bool> editing;
    in-out property <string> description-draft;

    callback edit-requested(string, string);
    callback save-requested(string, string);
    callback delete-task(string);

    min-width: 0px;

    HorizontalLayout {
        spacing: 12px;

        TaskTimelineMarker {
            width: 10px;
        }

        Rectangle {
            HorizontalLayout {
                padding-top: 5px;
                padding-bottom: 10px;
                min-height: 40px;

                VerticalLayout {
                    spacing: 5px;

                    Text {
                        text: root.entry.completed-label;
                        color: Theme.palette.secondary-text;
                        font-size: Theme.typography.caption.size;
                        font-weight: Theme.typography.caption.weight;
                    }

                    if (!root.editing): Rectangle {
                        height: description.preferred-height;

                        description := Text {
                            x: 0px;
                            width: 120px;
                            text: root.entry.note == "" ? @tr("No details added") : root.entry.note;
                            color: Theme.palette.text;
                            font-size: Theme.typography.body.size;
                            font-weight: Theme.typography.body.weight;
                            wrap: word-wrap;
                            horizontal-alignment: left;
                            vertical-alignment: top;
                        }
                    }

                    if (root.editing): Rectangle {
                        height: 34px;
                        background: Theme.palette.surface;

                        description-input := TextInput {
                            x: 10px;
                            y: 0px;
                            width: 100%;
                            height: 34px;
                            single-line: false;
                            wrap: word-wrap;
                            font-size: Theme.typography.body.size;
                            font-weight: Theme.typography.body.weight;
                            color: Theme.palette.text;
                            text <=> root.description-draft;
                            accepted => {
                                root.save-requested(root.entry.id, root.description-draft);
                            }
                        }
                    }
                }


				// Duration label and edit/delte buttons
                VerticalLayout {
                    Text {
                        width: 70px;
                        text: duration.text;
                        color: Theme.palette.accent;
                        font-size: Theme.typography.supporting.size;
                        font-weight: Theme.typography.body-strong.weight;
                        horizontal-alignment: right;
                    }

                    if (!root.editing): HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        IconButton {
                            icon: @image-url("../assets/icons/edit.svg");
                            icon-color: Theme.palette.accent;
                            clicked => { root.edit-requested(root.entry.id, root.entry.note); }
                        }

                        IconButton {
                            icon: @image-url("../assets/icons/delete.svg");
                            icon-color: Theme.palette.danger;
                            clicked => { root.delete-task(root.entry.id); }
                        }
                    }

                    if (root.editing): HorizontalLayout {
                        Button {
                            text: @tr("Save");
                            icon: @image-url("../assets/icons/check.svg");
                            height: 25px;
                            primary: true;
                            clicked => {
                                root.save-requested(root.entry.id, root.description-draft);
                            }
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.palette.section-divider;
            }

            duration := DurationLabel {
                seconds: root.entry.duration-seconds;
            }
        }
    }
}

export component DrilldownView inherits Rectangle {
    in property <EvaluationTasksState> state;
    private property <string> editing-task-id: "";
    private property <string> description-draft: "";

    callback open-evaluation-view();
    callback choose-range(Range);
    callback export-markdown();
    callback update-task(string, string);
    callback delete-task(string);

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        BackLink {
            text: @tr("Projects");
            clicked => { root.open-evaluation-view(); }
        }

        ViewHeader {
            text: root.state.project;
        }

        RangeList {
            range: root.state.range;
            clicked(range) => root.choose-range(range);
        }

        EvaluationSummary {
            total-seconds: root.state.total-seconds;
            range: root.state.range;
            vertical-stretch: 0;
        }

        Text {
            text: state.tasks.length == 1
                ? @tr("1 completed task")
                : state.tasks.length + " " + @tr("completed tasks");
            color: Theme.palette.muted-text;
            font-size: Theme.typography.caption.size;
            font-weight: Theme.typography.body-strong.weight;
        }

        ScrollView {
			VerticalLayout {
				width: 100%;

				for task in root.state.tasks: TaskCard {
	                entry: task;
	                editing: root.editing-task-id == task.id;
	                description-draft <=> root.description-draft;
	                edit-requested(id, note) => {
	                    root.editing-task-id = id;
	                    root.description-draft = note;
	                }
	                save-requested(id, note) => {
	                    root.update-task(id, note);
	                    root.editing-task-id = "";
	                }
	                delete-task(id) => { root.delete-task(id); }
	            }
			}
        }
        Rectangle { min-height: 0; vertical-stretch: 1;}


        AppButton {
            label: @tr("Export Markdown");
            prefix-icon: @image-url("../assets/icons/download.svg");
            primary: true;
            clicked => { root.export-markdown(); }
        }
    }
}
