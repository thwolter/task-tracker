import {
    ProjectItem,
    ProjectSettingsState,
    Page,
} from "../models.slint";
import { AppActions } from "../actions.slint";
import { Theme } from "../theme.slint";
import { BackLink } from "../components/back-link.slint";
import {
    ViewHeader,
    LabelText,
    BodyText,
} from "../components/typography.slint";
import { AppButton } from "../components/app-button.slint";
import { ScrollableColumn } from "../components/scrollable-column.slint";

export component ProjectRow inherits Rectangle {
    in property <ProjectItem> project;

    callback clicked();

    min-height: project.archived ? 50px : 44px;
    vertical-stretch: 0;

    border-radius: Theme.border.radius;
    border-width: Theme.border.width;
    border-color: Theme.border-default;

    background: touch.pressed ? Theme.action-card-pressed
        : touch.has-hover ? Theme.action-card-hover : Theme.surface-card;

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        cross-axis-alignment: center;

        VerticalLayout {
            spacing: 3px;
            Text {
                text: root.project.name;
                overflow: elide;
                color: Theme.content-primary;
                font-size: Theme.typography.body.size;
                font-weight: Theme.typography.body.weight;
            }

            if root.project.archived: Text {
                text: @tr("Archived");
                color: Theme.content-secondary;
                font-size: Theme.typography.caption.size;
                font-weight: Theme.typography.caption.weight;
            }
        }

        Image {
            source: @image-url("../assets/icons/chevron-right.svg");
            colorize: Theme.content-secondary;
            width: 16px;
            height: 16px;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Tooltip {
        text: @markdown("\{root.project.name}");
    }
}

export component SettingsView inherits Rectangle {
    in property <ProjectSettingsState> projects;
    private property <length> content-padding: 20px;
    private property <bool> archived-expanded: false;

    background: Theme.surface-canvas;
    VerticalLayout {
        padding: root.content-padding;
        spacing: 16px;
        BackLink {
            text: @tr("Home");
            clicked => { AppActions.navigate(Page.home); }
        }

        ViewHeader {
            text: @tr("Manage projects");
        }

        project-list := ScrollableColumn {
            // A stable gutter avoids width/scrollbar feedback when rows are laid out.
            property <length> row-width: root.width - 2 * root.content-padding - 10px;
            spacing: 8px;
            LabelText {
                text: @tr("Active");
            }

            if root.projects.active.length == 0: BodyText {
                text: @tr("No active projects. Add a project or restore one from the archive.");
                wrap: word-wrap;
            }
            for project in root.projects.active: ProjectRow {
                width: project-list.row-width;
                project: project;
                clicked => { AppActions.open-project-edit(project.id); }
            }
            if root.projects.archived.length > 0: VerticalLayout {
                padding-top: 12px;
                spacing: 8px;
                AppButton {
                    width: project-list.row-width;
                    label: @tr("Archived ({})", root.projects.archived.length);
                    primary: false;
                    suffix-icon: root.archived-expanded ? @image-url("../assets/icons/chevron-down.svg")
                        : @image-url("../assets/icons/chevron-right.svg");
                    clicked => { root.archived-expanded = !root.archived-expanded; }
                }

                if root.archived-expanded: VerticalLayout {
                    spacing: 8px;
                    for project in root.projects.archived: ProjectRow {
                        width: project-list.row-width;
                        project: project;
                        clicked => { AppActions.open-project-edit(project.id); }
                    }
                }
            }
        }

        AppButton {
            width: root.width - 2 * root.content-padding;
            label: @tr("Add project");
            prefix-icon: @image-url("../assets/icons/add.svg");
            clicked => { AppActions.open-project-create(); }
        }
    }
}
