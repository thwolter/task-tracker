import { AppButton, AppButtonSize } from "../components/app-button.slint";
import {
    TitleText,
    BodyText,
    LabelText,
    ViewHeader,
    TextLink,
} from "../components/typography.slint";
import { Theme } from "../theme.slint";
import { VerticalBox } from "std-widgets.slint";
import { BackLink } from "../components/back-link.slint";
import { Page, TaskItem } from "../models.slint";
import { AppActions } from "../actions.slint";
import { DurationLabel } from "../components/duration-label.slint";
import { TextEdit } from "../components/text-edit.slint";


export component NoteView inherits Rectangle {
    in property <TaskItem> last-task;
    in property <int> focus-request;
    property <string> note-draft: last-task.note;

    // Change callbacks are queued for the next event-loop turn, after this
    // dynamically created view has finished initializing.
    changed focus-request => {
        note.focus();
    }

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        VerticalLayout {
            spacing: 20px;

            BackLink {
                text: @tr("Home");
                clicked => { AppActions.navigate(Page.home); }
            }

            VerticalLayout {
                spacing: 10px;

                TitleText {
                    text: @tr("What did you get done?");
                }

                BodyText {
                    text: root.last-task.project + " · " + duration.text;
                    color: Theme.action-primary;
                }

                duration := DurationLabel {
                    seconds: root.last-task.duration-seconds;
                }
            }
        }

		Rectangle {
			background: Theme.surface-subtle;
	        VerticalLayout {
	            padding: 10px;
	            spacing:10px;
	            Text {
	                text: @tr("Session time");
	                font-size: Theme.typography.caption.size;
	                font-weight: Theme.typography.caption.weight;
	            }
	            HorizontalLayout {
	                alignment: space-between;
	                Text {
                    text: root.last-task.started-time + " – " + root.last-task.finished-time;
	                    font-size: Theme.typography.body-strong.size;
	                    font-weight: Theme.typography.body-strong.weight;
	                }
	                TextLink {
	                    text: @tr("Adjust time");
	                    clicked => { AppActions.open-adjust-time(); }
	                }
	            }
	        }
        }

        VerticalLayout {
            preferred-height: parent.height;
            alignment: space-between;

	        VerticalLayout {
	            spacing: 10px;
	            vertical-stretch: 0;

	            LabelText {
	                text: @tr("Add a brief note for your activity log.");
	            }

	            note := TextEdit {
	                text <=> root.note-draft;
	                placeholder: @tr("e.g. prepared the Q4 project brief");
	            }
	        }

	        VerticalLayout {
				spacing: 10px;

	            AppButton {
	                width: parent.width;
	                label: @tr("Save note");
	                enabled: root.note-draft != "";
	                size: AppButtonSize.large;
	                clicked => { AppActions.save-task-note(root.note-draft); }
	                horizontal-stretch: 1;
	            }

	            VerticalBox {
	                cross-axis-alignment: center;

	                TextLink {
	                    text: @tr("Skip for now");
	                    horizontal-alignment: center;
	                    vertical-alignment: top;

	                    clicked => { AppActions.navigate(Page.home); }
	                }
	            }
	        }
        }
    }
}
