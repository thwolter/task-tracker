import { AppButton } from "../components/app-button.slint";
import {
    TitleText,
    BodyText,
    LabelText,
    ViewHeader,
    TextLink,
} from "../components/typography.slint";
import { Theme } from "../theme.slint";
import { VerticalBox } from "std-widgets.slint";
import { BackLink } from "../components/back-link.slint";
import { Page, TaskItem } from "../models.slint";
import { AppActions } from "../actions.slint";
import { DurationLabel } from "../components/duration-label.slint";

component NoteEditor inherits Rectangle {
    in-out property <string> text;

    border-radius: Theme.border.radius;
    background: Theme.surface-soft;
    border-width: Theme.border.width;
    border-color: Theme.border-subtle;

    HorizontalLayout {
        padding: 10px;
        input := TextInput {
            height: 60px;
            width: 100%;
            single-line: false;
            wrap: word-wrap;
            font-size: Theme.typography.body.size;
            font-weight: Theme.typography.body.weight;
            color: Theme.content-primary;
            text <=> root.text;
        }
    }

    if root.text == "" && !input.has-focus: HorizontalLayout {
        padding: 10px;
        Text {
            width: 100%;
            text: @tr("e.g. prepared the Q4 project brief");
            wrap: word-wrap;
            color: Theme.content-muted;
            font-size: Theme.typography.body.size;
            font-weight: Theme.typography.body.weight;
        }
    }
}

export component NoteView inherits Rectangle {
    in property <TaskItem> last-task;
    property <string> note-draft: last-task.note;

    VerticalLayout {
        padding: 20px;
        spacing: 30px;

        VerticalLayout {
            spacing: 20px;

            BackLink {
                text: @tr("Home");
                clicked => { AppActions.navigate(Page.home); }
            }

            VerticalLayout {
                spacing: 10px;

                TitleText {
                    text: @tr("What did you get done?");
                }

                BodyText {
                    text: root.last-task.project + " · " + duration.text;
                    color: Theme.action-primary;
                }

                duration := DurationLabel {
                    seconds: root.last-task.duration-seconds;
                }
            }
        }

        VerticalLayout {
            spacing: 10px;
            vertical-stretch: 0;

            LabelText {
                text: @tr("Add a brief note for your activity log.");
            }

            NoteEditor {
                text <=> root.note-draft;
            }
        }

        Rectangle {
            min-height: 0px;
            horizontal-stretch: 1;
        }

        VerticalLayout {
            spacing: 10px;
            vertical-stretch: 0;

            AppButton {
                width: 100%;
                label: @tr("Save note");
                clicked => { AppActions.save-task-note(root.note-draft); }
                horizontal-stretch: 1;
            }

            VerticalBox {
                cross-axis-alignment: center;

                TextLink {
                    text: @tr("Skip for now");
                    horizontal-alignment: center;
                    vertical-alignment: top;

                    clicked => { AppActions.navigate(Page.home); }
                }
            }
        }
    }
}
