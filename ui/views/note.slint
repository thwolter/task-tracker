import { AppButton } from "../components/app-button.slint";
import { NoteEditor } from "../components/note-editor.slint";
import { ViewTitle } from "../components/view-title.slint";
import { Theme } from "../theme.slint";
import { VerticalBox } from "std-widgets.slint";

export component NoteView inherits Rectangle {
    in property <string> last-session;
    property <string> note-draft: "";

    callback save-note(string);
    callback skip();

    VerticalLayout {
        padding: 20px;
        spacing: 50px;

		VerticalLayout {
	        ViewTitle {
	            text: "What did you get done?";
	        }

	        Text {
	            text: root.last-session;
	            color: Theme.palette.accent;
	            font-size: Theme.typography.supporting.size;
	            font-weight: Theme.typography.supporting.weight;
	        }
        }

        VerticalLayout {
            spacing: 10px;
            vertical-stretch: 0;

	        Text {
	            text: "Add a brief note for your activity log.";
	            color: Theme.palette.muted-text;
	            font-size: Theme.typography.supporting.size;
	            vertical-alignment: bottom;
	        }

	        NoteEditor {
	            text <=> root.note-draft;
	        }
        }

		VerticalLayout {
			spacing: 10px;
			vertical-stretch: 0;

	        AppButton {
	            label: "Save note";
	            clicked => { root.save-note(root.note-draft); }
	        }

			VerticalBox {
				cross-axis-alignment: center;

		        Text {
		            text: "Skip for now";
		            color: Theme.palette.accent;
		            font-size: Theme.typography.body.size;
		            font-weight: Theme.typography.label.weight;
		            horizontal-alignment: center;
		            vertical-alignment: top;

		            TouchArea {
		                mouse-cursor: pointer;
			            clicked => { root.skip(); }
			        }
		        }
	        }
        }


    }
}
