import { AppButton, AppButtonIntent, AppButtonVariant, AppButtonSize } from "../components/app-button.slint";
import { TimerDisplay } from "../components/timer-display.slint";
import { Page, TrackingState } from "../models.slint";
import { AppActions } from "../actions.slint";
import { BackLink } from "../components/back-link.slint";
import { Theme } from "../theme.slint";

export component TrackingView inherits Rectangle {
    in property <TrackingState> state;

    VerticalLayout {
        padding: 20px;
        spacing: 10px;

        if (!root.state.secondary-active):  BackLink {
            text: @tr("Home");
            clicked => {
                AppActions.toggle-tracking-pause();
                AppActions.navigate(Page.home);
            }
        }

        VerticalLayout {
            vertical-stretch: 1;
            cross-axis-alignment: center;
            alignment: space-between;

            if (!root.state.secondary-active): VerticalLayout {
                cross-axis-alignment: center;
                spacing: 2px;
                Text {
                    text: @tr("Back to Home?");
                    color: Theme.content-muted;
                    font-size: Theme.typography.small-label.size;
                    font-weight: Theme.typography.small-label.weight;
                }
                Text {
                    text: @tr("Your task will be paused.");
                    wrap: word-wrap;
                    font-size: Theme.typography.small-label.size;
                    font-weight: Theme.typography.small-label.weight;
                    color: Theme.content-muted;
                }
            }
            if (root.state.secondary-active): Rectangle {}

            TimerDisplay {
                task: root.state.active-task;
                elapsed: root.state.elapsed;
                paused: root.state.paused;

                pause => { AppActions.toggle-tracking-pause(); }
            }

			VerticalLayout {
				spacing: 10px;

				// End tracking
	            AppButton {
	                width: 232px;
	                size: AppButtonSize.large;
	                label: @tr("End task");
	                intent: root.state.paused ? AppButtonIntent.secondary : AppButtonIntent.primary;

	                clicked => { AppActions.end-tracking(); }
	            }

	            // Pause tracking
	            AppButton {
	                width: 232px;
	                size: AppButtonSize.large;
                label: root.state.paused ? @tr("Resume") : @tr("Pause");
	                label-color: Theme.content-secondary;
	                variant: AppButtonVariant.outline;
	                intent: AppButtonIntent.secondary;

	                clicked => { AppActions.toggle-tracking-pause(); }
	            }
            }
        }
    }
}
