import { AppButton } from "../components/app-button.slint";
import { TitleText, ViewHeader } from "../components/typography.slint";
import {
    EvaluationState,
    ProjectTotalItem,
} from "../models.slint";
import { AppActions } from "../actions.slint";
import { Theme } from "../theme.slint";
import { BackLink } from "../components/back-link.slint";
import { ScrollableColumn } from "../components/scrollable-column.slint";
import { DurationLabel } from "../components/duration-label.slint";
import { EvaluationSummary } from "../components/evaluation-summary.slint";
import { RangeList } from "../components/range-list.slint";


export component ProjectCard inherits Rectangle {
    in property <ProjectTotalItem> entry;

    callback clicked(string);

    height: 46px;
    border-radius: 12px;
    background: Theme.palette.surface;
    border-width: 1px;
    border-color: Theme.palette.border;

    HorizontalLayout {
        width: 100%;
        padding-top: 8px;
        padding-bottom: 8px;
        padding-left: 15px;
        padding-right: 15px;
        cross-axis-alignment: center;

        VerticalLayout {
            spacing: 5px;
            horizontal-stretch: 1;

            Text {
                text: root.entry.project;
                color: Theme.palette.text;
                font-size: Theme.typography.body.size;
                font-weight: Theme.typography.body-strong.weight;
            }

            Text {
                text: entry.num-tasks == 1
				    ? @tr("1 task")
				    : entry.num-tasks + " " + @tr("tasks");
                color: Theme.palette.muted-text;
                font-size: Theme.typography.label.size;
            }
        }

        Text {
            horizontal-stretch: 0;
            text: duration.text;
            color: Theme.palette.accent;
            font-size: Theme.typography.supporting.size;
            font-weight: Theme.typography.body-strong.weight;
            horizontal-alignment: right;
        }


    }

    duration := DurationLabel {
        seconds: root.entry.duration-seconds;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(entry.id); }
    }
}

export component EvaluationView inherits Rectangle {
    in property <EvaluationState> state;

    callback open-home-view();

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        BackLink {
            text: @tr("Home");
            clicked => { root.open-home-view(); }
        }

        ViewHeader {
            text: @tr("Evaluation");
        }

        RangeList {
            range: root.state.range;
            clicked(range) => { AppActions.choose-range(range); }
        }

        EvaluationSummary {
            total-seconds: root.state.total-seconds;
            range: root.state.range;
            vertical-stretch: 0;
        }

        ScrollableColumn {
            for totals in root.state.project_totals: ProjectCard {
                entry: totals;
                clicked(project) => { AppActions.open-drilldown(project); }
            }
        }

        AppButton {
            label: @tr("Export Markdown");
            prefix-icon: @image-url("../assets/icons/download.svg");
            primary: true;
            clicked => { AppActions.export-markdown(); }
        }
    }
}
