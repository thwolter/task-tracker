import { HorizontalBox, VerticalBox, ScrollView } from "std-widgets.slint";
import { AppButton } from "../components/app-button.slint";
import { RangeOption } from "../components/range-option.slint";
import { TitleText, ViewHeader } from "../components/typography.slint";
import { EvaluationState, Range, TaskItem, ProjectTotalItem } from "../models.slint";
import { Theme } from "../theme.slint";
import { BackLink } from "../components/back-link.slint";

component EvaluationSummary inherits Rectangle {
    in property <string> total;

    height: 40px;
    border-radius: Theme.border.radius;
    background: Theme.palette.accent-surface;

    Text {
        x: 10px;
        text: root.total;
        color: Theme.palette.text;
        font-size: Theme.typography.supporting.size;
        font-weight: Theme.typography.supporting.weight;
        vertical-alignment: center;
    }
}

export component TaskCard inherits Rectangle {
    in property <TaskItem> entry;

    height: 46px;
    border-radius: 12px;
    background: Theme.palette.surface;
    border-width: 1px;
    border-color: Theme.palette.border;

    Text {
        x: 16px;
        y: 7px;
        text: root.entry.project;
        color: Theme.palette.text;
        font-size: Theme.typography.body.size;
        font-weight: Theme.typography.body-strong.weight;
    }

    Text {
        x: 16px;
        y: 25px;
        text: root.entry.note == "" ? @tr("No details added") : root.entry.note;
        color: Theme.palette.muted-text;
        font-size: Theme.typography.label.size;
    }

    Text {
        x: 163px;
        y: 15px;
        width: 52px;
        text: root.entry.duration;
        color: Theme.palette.accent;
        font-size: Theme.typography.supporting.size;
        font-weight: Theme.typography.body-strong.weight;
        horizontal-alignment: right;
    }
}

export component ProjectCard inherits Rectangle {
    in property <ProjectTotalItem> entry;

    height: 46px;
    border-radius: 12px;
    background: Theme.palette.surface;
    border-width: 1px;
    border-color: Theme.palette.border;

	HorizontalLayout {
		padding-top: 8px;
		padding-bottom: 8px;
		padding-left: 15px;
		padding-right: 15px;
		cross-axis-alignment: center;

		VerticalLayout {
			spacing: 5px;

			Text {
		        text: root.entry.project;
		        color: Theme.palette.text;
		        font-size: Theme.typography.body.size;
		        font-weight: Theme.typography.body-strong.weight;
		    }

		    Text {
		        text: @tr("{n} task" | "{n} tasks" % entry.num-tasks);
		        color: Theme.palette.muted-text;
		        font-size: Theme.typography.label.size;
		    }
		}

	    Text {
	        width: 52px;
	        text: root.entry.total;
	        color: Theme.palette.accent;
	        font-size: Theme.typography.supporting.size;
	        font-weight: Theme.typography.body-strong.weight;
	        horizontal-alignment: right;
	    }
	}
}

component ProjectList inherits ScrollView {
	in property <EvaluationState> state;

	vertical-stretch: 1;
	horizontal-scrollbar-policy: always-off;

	private property <bool> has-scrollbar: self.viewport-height > self.visible-height;

	VerticalLayout {
		x: 0px;
        spacing: 7px;
        width: root.width - (has-scrollbar ? 20px : 0px);
        for total in root.state.project_totals: ProjectCard {
            entry: total;
        }
    }
}

export component EvaluationView inherits Rectangle {
    in property <EvaluationState> state;

    callback open-home-view();
    callback choose-range(Range);
    callback export-markdown();

	VerticalLayout {
		padding: 20px;
		spacing: 20px;

		BackLink {
			text: @tr("Home");
			clicked => { root.open-home-view(); }
		}

	    ViewHeader {
	        text: @tr("Evaluation");
	    }

	    HorizontalLayout {
	        spacing: 6px;
	        for option in [
	            { label: @tr("Day"), value: Range.day },
	            { label: @tr("Week"), value: Range.week },
	            { label: @tr("Month"), value: Range.month },
	            { label: @tr("Year"), value: Range.year }
	        ]: RangeOption {
	            label: option.label;
	            value: option.value;
	            selected: root.state.range == option.value;
	            clicked(value) => { root.choose-range(value); }
	        }
	    }

	    EvaluationSummary {
	        total: root.state.total;
	        vertical-stretch: 0;
	    }

		ProjectList {
			state: root.state;
		}

	    AppButton {
	        label: @tr("Export Markdown");
	        prefix-icon: @image-url("../assets/icons/download.svg");
	        primary: true;
	        clicked => { root.export-markdown(); }
	    }
    }
}
