import { AppButton } from "../components/app-button.slint";
import { ViewHeader } from "../components/typography.slint";
import {
    EvaluationTasksState,
    EvaluationTaskItem,
    Range,
} from "../models.slint";
import { Theme } from "../theme.slint";
import { BackLink } from "../components/back-link.slint";
import { ScrollableColumn } from "../components/scrollable-column.slint";
import { DurationLabel } from "../components/duration-label.slint";
import { EvaluationSummary } from "../components/evaluation-summary.slint";
import { RangeList } from "../components/range-list.slint";

export component TaskCard inherits Rectangle {
    in property <EvaluationTaskItem> entry;

    height: 72px;

    Rectangle {
        x: 4px;
        width: 2px;
        height: parent.height;
        background: Theme.palette.soft-border;
    }

    Rectangle {
        x: 0px;
        y: 8px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.palette.accent;
    }

    Text {
        x: 22px;
        y: 7px;
        width: parent.width - 96px;
        height: 36px;
        text: root.entry.note == "" ? @tr("No details added") : root.entry.note;
        color: Theme.palette.text;
        font-size: Theme.typography.body.size;
        font-weight: Theme.typography.body-strong.weight;
        wrap: word-wrap;
    }

    Text {
        x: parent.width - 72px;
        y: 8px;
        width: 72px;
        text: duration.text;
        color: Theme.palette.accent;
        font-size: Theme.typography.supporting.size;
        font-weight: Theme.typography.body-strong.weight;
        horizontal-alignment: right;
    }

    Text {
        x: 22px;
        y: 48px;
        text: @tr("Completed session");
        color: Theme.palette.secondary-text;
        font-size: Theme.typography.caption.size;
        font-weight: Theme.typography.caption.weight;
    }

    Rectangle {
        x: 22px;
        y: parent.height - 1px;
        width: parent.width - 22px;
        height: 1px;
        background: Theme.palette.section-divider;
    }

    duration := DurationLabel {
        seconds: root.entry.duration-seconds;
    }
}

export component EvaluationTasksView inherits Rectangle {
    in property <EvaluationTasksState> state;

    callback open-evaluation-view();
    callback choose-range(Range);
    callback export-markdown();

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

        BackLink {
            text: @tr("Projects");
            clicked => { root.open-evaluation-view(); }
        }

        ViewHeader {
            text: root.state.project;
        }

        RangeList {
            range: root.state.range;
            clicked(range) => root.choose-range(range);
        }

        EvaluationSummary {
            total-seconds: root.state.total-seconds;
            range: root.state.range;
            vertical-stretch: 0;
        }

        Text {
            text: state.tasks.length == 1
                ? @tr("1 completed task")
                : state.tasks.length + " " + @tr("completed tasks");
            color: Theme.palette.muted-text;
            font-size: Theme.typography.caption.size;
            font-weight: Theme.typography.body-strong.weight;
        }

        ScrollableColumn {
            spacing: 0px;

            for task in root.state.tasks: TaskCard {
                entry: task;
            }
        }


        AppButton {
            label: @tr("Export Markdown");
            prefix-icon: @image-url("../assets/icons/download.svg");
            primary: true;
            clicked => { root.export-markdown(); }
        }
    }
}
