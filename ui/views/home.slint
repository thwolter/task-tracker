import { ScrollView, VerticalBox } from "std-widgets.slint";
import { ProjectCard } from "../components/project-card.slint";
import { HomeState, TaskItem } from "../models.slint";
import { AppActions } from "../actions.slint";
import { Theme } from "../theme.slint";
import { ViewHeader } from "../components/typography.slint";
import { ScrollableColumn } from "../components/scrollable-column.slint";
import { DurationLabel } from "../components/duration-label.slint";

component HomeHeader inherits HorizontalLayout {
    alignment: stretch;
    cross-axis-alignment: center;

    private property <string> evaluation-tooltip: @tr("Evaluation");
    private property <string> project-settings-tooltip: @tr("Manage projects");

    callback open-settings();
    callback open-evaluation();

    ViewHeader {
        text: @tr("What next?");
    }

    HorizontalLayout {
        spacing: 10px;

        Rectangle {
            evaluation-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { open-evaluation(); }
            }

            background: evaluation-touch.pressed ? Theme.action-icon-pressed
                : evaluation-touch.has-hover ? Theme.action-icon-hover
                : Theme.action-icon;
            width: 20px;
            height: 20px;

            Image {
                source: @image-url("../assets/icons/bar-chart.svg");
                colorize: Theme.content-secondary;
                width: 18px;
            }

            Tooltip {
                text: @markdown("\{root.evaluation-tooltip}");
            }
        }

        Rectangle {
            settings-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { open-settings(); }
            }

            background: settings-touch.pressed ? Theme.action-icon-pressed
                : settings-touch.has-hover ? Theme.action-icon-hover
                : Theme.action-icon;
            width: 20px;
            height: 20px;

            Image {
                source: @image-url("../assets/icons/settings.svg");
                colorize: Theme.content-secondary;
                width: 18px;
            }

            Tooltip {
                text: @markdown("\{root.project-settings-tooltip}");
            }
        }
    }
}

component LastTaskCard inherits Rectangle {
    in property <TaskItem> task;

    private property <string> add-task-tooltip: @tr("Add a task");

    callback clicked();

    min-height: 60px;
    border-radius: 10px;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }

        duration := DurationLabel {
            seconds: root.task.duration-seconds;
        }

        VerticalBox {
            spacing: 6px;

            Text {
                text: @tr("LAST SESSION · TAP TO ADD A NOTE");
                color: Theme.action-primary;
                font-size: Theme.typography.caption.size;
                font-weight: Theme.typography.caption.weight;
            }

            Text {
                text: task.project + " · " + duration.text;
                color: Theme.content-primary;
                font-size: Theme.typography.body-strong.size;
                font-weight: Theme.typography.body-strong.weight;
            }

            Text {
                text: task.note != "" ? task.note : @tr("[No task description]");
                color: Theme.content-muted;
                wrap: word-wrap;
                font-size: Theme.typography.label.size;
                font-weight: Theme.typography.label.weight;
            }
        }

        Tooltip {
            text: @markdown("\{root.add-task-tooltip}");
        }
    }

    background: touch.pressed ? Theme.action-card-pressed
        : touch.has-hover ? Theme.action-card-hover
        : Theme.surface-subtle;
}

component Footer inherits Text {
    height: 16px;
    color: Theme.content-muted;
    font-size: Theme.typography.label.size;
    font-weight: Theme.typography.label.weight;
    vertical-alignment: center;
    horizontal-alignment: center;
}

export component HomeView inherits Rectangle {
    in property <HomeState> state;

    private property <length> footer-clearance: 20px;

    callback open-settings();
    callback open-evaluation();

    content := Rectangle {
        width: root.width;
        height: root.height;

        VerticalLayout {
            padding: 20px;
            spacing: 25px;
            alignment: stretch;

            HomeHeader {
                open-settings => { open-settings(); }
                open-evaluation => { open-evaluation(); }
            }

            if (root.state.has-last-task): LastTaskCard {
                task: root.state.last-task;
                clicked => { AppActions.open-last-task(); }
            }

            VerticalLayout {
                spacing: 10px;

                Text {
                    text: @tr("Start a timer");
                    color: Theme.action-primary;
                    font-size: Theme.typography.label.size;
                    font-weight: Theme.typography.label.weight;
                }

                project-list := ScrollableColumn {
                    for project in root.state.projects: ProjectCard {
                        project: project;
                        clicked(id) => { AppActions.start-tracking(id); }
                    }
                    // Always present: it is part of the scrollable viewport.
	                Rectangle {
                        height: root.footer-clearance;
                    }
                }
            }
        }

        if (!project-list.has-scrollbar): Footer {
            text: @tr("A quiet place to keep your day moving.");
            y: root.height - self.height - 15px;
        }
    }
}
