import { ProjectSettingsState, ProjectItem } from "../../models.slint";

import { ScrollableColumn } from "../../components/scrollable-column.slint";
import {
    ViewHeader,
    BodyText,
    LabelText,
} from "../../components/typography.slint";
import { BackLink } from "../../components/back-link.slint";
import { ProjectRow } from "project-row.slint";
import { AppButton } from "../../components/app-button.slint";

export component ProjectList inherits Rectangle {
    in property <ProjectSettingsState> projects;

    private property <length> content-padding: 20px;
    private property <bool> archived-expanded: false;

    callback open-home-view();
    callback open-project(ProjectItem);
    callback create-project();

    VerticalLayout {
        padding: 20px;
        spacing: 16px;
        BackLink {
            text: @tr("Home");
            clicked => { root.open-home-view(); }
        }

        ViewHeader {
            text: @tr("Manage projects");
        }

        project-list := ScrollableColumn {
        // A stable gutter avoids width/scrollbar feedback when rows are laid out.
        property <length> row-width: root.width - 2 * root.content-padding - 10px;
            spacing: 8px;
            LabelText {
                text: @tr("Active");
            }

            if root.projects.active.length == 0: BodyText {
                text: @tr("No active projects. Add a project or restore one from the archive.");
                wrap: word-wrap;
            }
            for project in root.projects.active: ProjectRow {
                width: project-list.row-width;
                project: project;
                clicked => { root.open-project(project); }
            }
            if root.projects.archived.length > 0: VerticalLayout {
                padding-top: 12px;
                spacing: 8px;
                AppButton {
                    width: project-list.row-width;
                    label: @tr("Archived ({})", root.projects.archived.length);
                    primary: false;
                    suffix-icon: root.archived-expanded ? @image-url("../../assets/icons/chevron-down.svg")
                        : @image-url("../../assets/icons/chevron-right.svg");
                    clicked => { root.archived-expanded = !root.archived-expanded; }
                    accessible-expanded: root.archived-expanded;
                }

                if root.archived-expanded: VerticalLayout {
                    spacing: 8px;
                    for project in root.projects.archived: ProjectRow {
                        width: project-list.row-width;
                        project: project;
                        clicked => { root.open-project(project); }
                    }
                }
            }
        }

        AppButton {
            width: root.width - 2 * root.content-padding;
            label: @tr("Add project");
            prefix-icon: @image-url("../../assets/icons/add.svg");
            clicked => { root.create-project(); }
        }
    }
}
