import { ProjectItem } from "../../models.slint";
import { Theme } from "../../theme.slint";

// One focusable target per row; the chevron is decorative.
export component ProjectRow inherits Rectangle {
    in property <ProjectItem> project;

    callback clicked();

    min-height: project.archived ? 50px : 44px;
    vertical-stretch: 0;
    border-radius: Theme.border.radius;
    border-width: focus.has-focus ? 2px : Theme.border.width;
    border-color: focus.has-focus ? Theme.action-primary : Theme.border-default;
    background: touch.pressed ? Theme.action-card-pressed
        : touch.has-hover ? Theme.action-card-hover : Theme.surface-card;
    accessible-role: button;
    accessible-label: project.name + (project.archived ? " · " + @tr("Archived") : "");
    accessible-action-default => { root.clicked(); }
    forward-focus: focus;

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        cross-axis-alignment: center;

        VerticalLayout {
            spacing: 3px;

            Text {
                text: root.project.name;
                overflow: elide;
                color: Theme.content-primary;
                font-size: Theme.typography.body.size;
                font-weight: Theme.typography.body.weight;
            }

            if root.project.archived: Text {
                text: @tr("Archived");
                color: Theme.content-secondary;
                font-size: Theme.typography.caption.size;
                font-weight: Theme.typography.caption.weight;
            }
        }

        Image {
            source: @image-url("../../assets/icons/chevron-right.svg");
            colorize: Theme.content-secondary;
            width: 16px;
            height: 16px;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }

    Tooltip {
        text: @markdown("\{root.project.name}");
    }
}
