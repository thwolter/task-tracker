import { Range } from "../models.slint";
import { Theme } from "../theme.slint";

export component RangeOption inherits Rectangle {
    in property <string> label;
    in property <Range> value;
    in property <bool> selected;
    callback clicked(Range);

    touch := TouchArea {
        clicked => { root.clicked(root.value); }
    }

    width: 52px;
    height: 30px;
    border-radius: 16px;
    background: root.selected
        ? (touch.pressed ? Theme.action-primary-pressed
            : touch.has-hover ? Theme.action-primary-hover
            : Theme.action-primary)
        : (touch.pressed ? Theme.action-secondary-pressed
            : touch.has-hover ? Theme.action-secondary-hover
            : Theme.surface-card);
    border-width: root.selected ? 0px : 1px;
    border-color: Theme.border-default;
    Text {
        text: root.label;
        color: root.selected
            ? (touch.pressed ? Theme.content-on-primary-pressed
                : touch.has-hover ? Theme.content-on-primary-hover
                : Theme.content-on-accent)
            : Theme.content-muted;
        font-size: Theme.typography.label.size;
        font-weight: Theme.typography.label.weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

}

export component RangeList inherits HorizontalLayout {
    in property <Range> range;

    callback clicked(Range);

    spacing: 6px;
    for option in [
        { label: @tr("Day"), value: Range.day },
        { label: @tr("Week"), value: Range.week },
        { label: @tr("Month"), value: Range.month },
        { label: @tr("Year"), value: Range.year }
    ]: RangeOption {
        label: option.label;
        value: option.value;
        selected: root.range == option.value;
        clicked(value) => { root.clicked(value); }
    }
}
