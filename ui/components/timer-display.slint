import { Theme } from "../theme.slint";

export component TimerDisplay inherits Rectangle {
    in property <string> task;
    in property <string> elapsed;
    in property <bool> paused;

    callback pause();

    x: 59px;
    y: 43px;

    width: 162px;
    height: 162px;

    border-radius: 81px;
    background: Theme.timer-ring;

    Rectangle {
        x: 9px;
        y: 9px;
        width: 144px;
        height: 144px;
        border-radius: 72px;
        background: Theme.surface-card;

        Text {
            y: 40px;
            text: root.task;
            color: Theme.action-primary;
            font-size: Theme.typography.small-label.size;
            font-weight: Theme.typography.small-label.weight;
            letter-spacing: 1.2px;
            horizontal-alignment: center;
        }

        Text {
            y: 60px;
            text: root.elapsed;
            color: Theme.content-primary;
            opacity: root.paused ? 0.55 : 1;
            font-size: Theme.typography.timer.size;
            font-weight: Theme.typography.timer.weight;
            horizontal-alignment: center;

            animate opacity {
                duration: 800ms;
                iteration-count: -1;
                direction: alternate;
                easing: ease-in-out;
                enabled: root.paused;
            }
        }

        Image {
            y: 100px;
            source: @image-url("../assets/icons/pause.svg");
            colorize: Theme.timer-ring;
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pause(); }
    }
}
