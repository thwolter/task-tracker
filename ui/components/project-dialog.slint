import { LineEdit } from "std-widgets.slint";
import { AppButton } from "app-button.slint";
import { BackLink } from "back-link.slint";
import { Theme } from "../theme.slint";
import { ViewTitle } from "view-title.slint";
import { BodyText } from "body-text.slint";

export component ProjectDialog inherits Rectangle {
    in property <bool> rename-mode;
    in property <string> initial-draft;

    property <string> task-draft: root.initial-draft;

    callback close();
    callback save(string);
    callback archive(string);

    background: Theme.palette.soft-surface;

    VerticalLayout {
        padding: 20px;
        spacing: 20px;

		BackLink {
            text: "Project settings";
            clicked => { root.close(); }

        }

        ViewTitle {
            text: "New project";
        }

        BodyText {
            text: "Keep the name clear and easy to spot in your timer.";
        }

        Rectangle {
            height: 42px;
            background: Theme.palette.surface;

			HorizontalLayout {
				padding: 10px;

				task-input := TextInput {
	                vertical-alignment: center;
	                single-line: true;
	                width: 100%;
	                font-size: Theme.typography.body.size;

	                accepted => { root.save(root.task-draft); }
	                text <=> root.task-draft;
	            }
			}

        }

		HorizontalLayout {
			spacing: 20px;
			alignment: end;

	        AppButton {
	            width: 140px;
	            height: 40px;
	            label: "Save name";
	            prefix-icon: @image-url("../assets/icons/check.svg");
	            clicked => { root.save(root.task-draft); }
	        }
		}
		Rectangle {}

        Rectangle {
            height: 1px;
            background: Theme.palette.section-divider;
        }

		VerticalLayout {
			spacing: 10px;
			ViewTitle {
	            text: "Archive project";
	        }

	        BodyText {
	            text: "Removes it from your task list. Your past time entries stay in Evaluation.";
	            wrap: word-wrap;
	            vertical-alignment: center;
	        }

			HorizontalLayout {
				alignment: start;
				TouchArea {
					mouse-cursor: pointer;
					clicked => { root.archive(root.task-draft); }
					Text {
						text: "Archive project";
						color: Theme.palette.danger;
						font-size: Theme.typography.body.size;
					}
				}
			}
		}

    }
}
