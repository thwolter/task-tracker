import { LineEdit } from "std-widgets.slint";
import { AppButton } from "app-button.slint";
import { Theme } from "../theme.slint";

export component ProjectDialog inherits Rectangle {
    in property <bool> rename-mode;
    in property <string> initial-draft;

    property <string> task-draft: root.initial-draft;
    forward-focus: keyboard-scope;

    callback close();
    callback save(string);

    background: Theme.palette.overlay;

    init => { task-input.focus(); }

    keyboard-scope := FocusScope {
        forward-focus: task-input;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close();
                accept
            } else {
                reject
            }
        }

        Rectangle {
            x: 20px;
            y: 145px;
            width: 240px;
            height: 170px;
            border-radius: 18px;
            background: Theme.palette.surface;
            Text {
                x: 20px;
                y: 20px;
                text: root.rename-mode ? "Rename project" : "Add project";
                color: Theme.palette.text;
                font-size: Theme.typography.title.size;
                font-weight: Theme.typography.title.weight;
            }

            Rectangle {
                x: 20px;
                y: 58px;
                width: 200px;
                height: 38px;
                border-radius: 10px;
                border-color: Theme.palette.soft-border;
                task-input := LineEdit {
                    x: 10px;
                    width: parent.width - 20px;
                    height: parent.height;
                    text <=> root.task-draft;
                    font-size: Theme.typography.body.size;
                    accepted => { root.save(root.task-draft); }
                }
            }

            AppButton {
                x: 20px;
                y: 112px;
                width: 92px;
                height: 38px;
                label: "Archive";
                primary: true;
                background: Theme.palette.danger;
                clicked => { root.close(); }
            }

            AppButton {
                x: 128px;
                y: 112px;
                width: 92px;
                height: 38px;
                label: "Save";
                clicked => { root.save(root.task-draft); }
            }
        }
    }
}
