import { Theme } from "../theme.slint";
import { HorizontalBox } from "std-widgets.slint";

export component AppButton inherits Rectangle {
    in property <string> label: "Button";
    in property <bool> primary: true;
    in property <image> suffix-icon;
    in property <image> prefix-icon;

	private property <color> text-color: root.primary ? Theme.palette.on-accent : Theme.palette.text;
	private property <length> icon-width: Theme.typography.body-strong.size + 2px;

    callback clicked();

    height: 48px;
    border-radius: Theme.border.radius;
    background: primary ? Theme.palette.accent : Theme.palette.accent-surface;

	HorizontalBox {
		alignment: center;
		cross-axis-alignment: center;
		spacing: 2px;

		if (root.prefix-icon.width > 0): Image {
	        source: prefix-icon;
	        width: icon-width;
	        height: icon-width;
	        colorize: root.text-color;
	    }

	    Text {
	        text: root.label;
	        color: root.text-color;
	        font-size: Theme.typography.body-strong.size;
	        font-weight: Theme.typography.body-strong.weight;
	        horizontal-alignment: center;
	        vertical-alignment: center;
	    }

		if (root.suffix-icon.width > 0): Image {
	        source: suffix-icon;
	        width: icon-width;
	        height: icon-width;
	        colorize: root.text-color;
	    }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
