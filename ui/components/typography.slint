import { Theme } from "../theme.slint";

export enum TextLinkVariant {
    default,
    danger,
}

export component TitleText inherits Text {
    horizontal-stretch: 1;
    color: Theme.content-primary;
    font-size: Theme.typography.title.size;
    font-weight: Theme.typography.title.weight;
}

export component BodyText inherits Text {
    color: Theme.content-secondary;
    font-size: Theme.typography.body.size;
    font-weight: Theme.typography.body.weight;
}

export component ViewHeader inherits Text {
    horizontal-stretch: 1;
    color: Theme.content-primary;
    font-size: Theme.typography.heading.size;
    font-weight: Theme.typography.heading.weight;
}

export component LabelText inherits Text {
    color: Theme.content-muted;
    font-size: Theme.typography.label.size;
    font-weight: Theme.typography.label.weight;
}

export component TextLink inherits Text {
    callback clicked();
    in property <TextLinkVariant> variant: TextLinkVariant.default;

    private property <color> default-color: variant == TextLinkVariant.danger
        ? Theme.action-danger
        : Theme.content-link;
    private property <color> hover-color: variant == TextLinkVariant.danger
        ? Theme.action-danger-hover
        : Theme.content-link-hover;
    private property <color> pressed-color: variant == TextLinkVariant.danger
        ? Theme.action-danger-pressed
        : Theme.content-link-pressed;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    color: touch.pressed ? root.pressed-color
        : touch.has-hover ? root.hover-color
        : root.default-color;
    font-size: Theme.typography.body-link.size;
    font-weight: Theme.typography.body-link.weight;

}
