export component DurationLabel {
    visible: false;
    height: 0px;

    in property <int> seconds;
    out property <string> text: minutes >= 60
        ? @tr("{} h {} min", minutes / 60, Math.mod(minutes, 60))
        : @tr("{} min", minutes);

    private property <int> minutes: (root.seconds + 30) / 60;
}
