import { SessionItem } from "../models.slint";
import { Theme } from "../theme.slint";

export component SessionCard inherits Rectangle {
    in property <SessionItem> entry; height: 46px; border-radius: 12px; background: Theme.palette.surface; border-width: 1px; border-color: Theme.palette.border;
    Text { x: 16px; y: 7px; text: root.entry.task; color: Theme.palette.text; font-size: Theme.typography.body.size; font-weight: Theme.typography.body-strong.weight; }
    Text { x: 16px; y: 25px; text: root.entry.note == "" ? "No details added" : root.entry.note; color: Theme.palette.muted-text; font-size: Theme.typography.label.size; }
    Text { x: 163px; y: 15px; width: 52px; text: root.entry.duration; color: Theme.palette.accent; font-size: Theme.typography.supporting.size; font-weight: Theme.typography.body-strong.weight; horizontal-alignment: right; }
}
