import { Theme } from "../theme.slint";

export component BackLink inherits Rectangle {
    in property <string> text: @tr("Back");
    in property <image> prefix-icon: @image-url("../assets/icons/chevron-left.svg");

    private property <length> icon-width: Theme.typography.label.size + 4px;

    callback clicked();

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    forward-focus: keyboard-focus;
    keyboard-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            reject
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    border-width: keyboard-focus.has-focus ? 1px : 0px;
    border-color: Theme.action-primary;
    border-radius: Theme.border.radius;

    HorizontalLayout {
        cross-axis-alignment: center;
        spacing: -5px;

        Rectangle {
            width: icon-width;
            height: icon-width;
            clip: true;

            Image {
                x: -4px; // adjust until the visible chevron is flush left
		        width: icon-width;
                height: icon-width;
                source: root.prefix-icon;
                colorize: touch.pressed ? Theme.content-link-pressed
                    : touch.has-hover ? Theme.content-link-hover
                    : Theme.content-link;
            }
        }

        Text {
            text: root.text;
            font-size: Theme.typography.supporting.size;
            font-weight: Theme.typography.supporting.weight;
            color: touch.pressed ? Theme.content-link-pressed
                : touch.has-hover ? Theme.content-link-hover
                : Theme.content-secondary;
        }
    }
}
