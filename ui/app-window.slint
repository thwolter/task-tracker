import { LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Page, Range, TaskItem, SessionItem } from "models.slint";

component AppButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    callback clicked();
    height: 42px;
    border-radius: 14px;
    background: primary ? #296e45 : #fffffc;
    border-width: primary ? 0px : 1px;
    border-color: #d6e0d4;
    Text { text: root.label; color: root.primary ? #ffffff : #14241a; font-size: 15px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

component TaskCard inherits Rectangle {
    in property <TaskItem> task;
    callback clicked(string);
    height: 42px;
    border-radius: 14px;
    background: #fffffc;
    border-width: 1px;
    border-color: #d6e0d4;
    Text { x: 16px; text: "•"; color: #296e45; font-size: 22px; vertical-alignment: center; }
    Text { x: 50px; text: root.task.title; color: #14241a; font-size: 15px; font-weight: 700; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(root.task.id); } }
}

component Header inherits Rectangle {
    height: 48px;
    background: #e8f0e5;
    Text { x: 16px; text: "●  ●  ●"; color: #637d66; font-size: 10px; font-weight: 700; vertical-alignment: center; }
    Text { text: "TEMPO"; color: #1f472b; font-size: 12px; font-weight: 700; letter-spacing: 1.4px; horizontal-alignment: center; vertical-alignment: center; }
}

export component AppWindow inherits Window {
    title: "Tempo";
    width: 280px;
    height: 460px;
    background: #f6f8f6;

    in-out property <Page> page: Page.home;
    in-out property <[TaskItem]> tasks: [];
    in-out property <[SessionItem]> sessions: [];
    in-out property <string> active-task: "";
    in-out property <string> elapsed: "00:00";
    in-out property <string> last-session: "";
    in-out property <string> total: "TODAY  0 min";
    in-out property <Range> range: Range.day;
    in-out property <bool> task-dialog-open: false;
    in-out property <bool> rename-mode: false;
    in-out property <string> task-draft: "";
    in-out property <string> note-draft: "";
    in-out property <string> status: "";

    callback start-task(string);
    callback open-settings();
    callback open-last-session();
    callback end-task();
    callback save-note(string);
    callback skip-note();
    callback open-evaluation();
    callback choose-range(Range);
    callback open-add-task();
    callback open-rename-task(string);
    callback save-task(string);
    callback close-task-dialog();
    callback choose-data-file();
    callback new-data-file();
    callback delete-data-file();
    callback export-markdown();

    Header { }

    // Home
    if root.page == Page.home : Rectangle {
        y: 48px; height: parent.height - self.y; width: parent.width;
        Text { x: 24px; y: 28px; text: "What next?"; color: #14241a; font-size: 20px; font-weight: 700; }
        Text { x: 232px; y: 28px; text: "•••"; color: #296e45; font-size: 18px; font-weight: 700; }
        TouchArea { x: 220px; y: 16px; width: 48px; height: 42px; clicked => { root.open-settings(); } }
        Rectangle { x: 24px; y: 64px; width: 232px; height: 56px; border-radius: 14px; background: #e0f0de;
            Text { x: 16px; y: 11px; text: "LAST SESSION  ·  TAP TO ADD A NOTE"; color: #296e45; font-size: 10px; font-weight: 600; }
            Text { x: 16px; y: 29px; text: root.last-session; color: #14241a; font-size: 15px; font-weight: 700; }
            TouchArea { clicked => { root.open-last-session(); } }
        }
        Text { x: 24px; y: 133px; text: "Start a timer"; color: #296e45; font-size: 12px; font-weight: 600; }
        VerticalBox { x: 24px; y: 157px; width: 232px; spacing: 6px;
            for task in root.tasks : TaskCard { task: task; clicked(id) => { root.start-task(id); } }
        }
        Text { x: 24px; y: 370px; text: "A quiet place to keep your day moving."; color: #526654; font-size: 12px; }
    }

    // Tracking
    if root.page == Page.tracking : Rectangle {
        y: 48px; height: parent.height - self.y; width: parent.width;
        Rectangle { x: 59px; y: 43px; width: 162px; height: 162px; border-radius: 81px; background: #d6f0d6; }
        Rectangle { x: 68px; y: 52px; width: 144px; height: 144px; border-radius: 72px; background: #fffffc;
            Text { y: 32px; text: root.active-task; color: #296e45; font-size: 11px; font-weight: 600; letter-spacing: 1.2px; horizontal-alignment: center; }
            Text { y: 52px; text: root.elapsed; color: #14241a; font-size: 32px; font-weight: 700; horizontal-alignment: center; }
        }
        AppButton { x: 24px; y: 301px; width: 232px; height: 50px; label: "End task"; primary: true; clicked => { root.end-task(); } }
    }

    // Note
    if root.page == Page.note : Rectangle {
        y: 48px; height: parent.height - self.y; width: parent.width;
        Text { x: 24px; y: 35px; text: "What did you get done?"; color: #14241a; font-size: 18px; font-weight: 700; }
        Text { x: 24px; y: 71px; text: root.last-session; color: #296e45; font-size: 13px; font-weight: 600; }
        Text { x: 24px; y: 102px; text: "Add a brief note for your activity log."; color: #526654; font-size: 13px; }
        Rectangle { x: 24px; y: 131px; width: 232px; height: 90px; border-radius: 14px; background: #edf5eb; border-width: 1px; border-color: #c9d6c7;
            LineEdit { x: 16px; y: 12px; width: parent.width - 32px; height: 36px; text <=> root.note-draft; font-size: 14px; }
            Text { x: 16px; y: 54px; text: root.note-draft == "" ? "e.g. prepared the Q4 project brief" : ""; color: #738273; font-size: 12px; }
        }
        AppButton { x: 24px; y: 251px; width: 232px; height: 48px; label: "Save note"; primary: true; clicked => { root.save-note(root.note-draft); } }
        Text { x: 94px; y: 323px; text: "Skip for now"; color: #296e45; font-size: 14px; font-weight: 600; }
        TouchArea { x: 75px; y: 310px; width: 130px; height: 38px; clicked => { root.skip-note(); } }
    }

    // Settings
    if root.page == Page.settings : Rectangle {
        y: 48px; height: parent.height - self.y; width: parent.width;
        Text { x: 24px; y: 23px; text: "Tasks"; color: #14241a; font-size: 21px; font-weight: 700; }
        Text { x: 24px; y: 60px; text: "YOUR TASKS"; color: #296e45; font-size: 11px; font-weight: 600; }
        VerticalBox { x: 24px; y: 72px; width: 232px; spacing: 7px;
            for task in root.tasks : Rectangle { height: 38px; border-radius: 12px; background: #fffffc; border-width: 1px; border-color: #d6e0d4;
                Text { x: 16px; text: task.title; color: #14241a; font-size: 15px; font-weight: 600; vertical-alignment: center; }
                Text { x: 196px; text: "Edit"; color: #296e45; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                TouchArea { clicked => { root.open-rename-task(task.id); } }
            }
        }
        AppButton { x: 24px; y: 267px; width: 104px; label: "+  Add task"; clicked => { root.open-add-task(); } }
        Text { x: 24px; y: 319px; text: "Change file"; color: #296e45; font-size: 12px; font-weight: 600; }
        TouchArea { x: 16px; y: 302px; width: 100px; height: 35px; clicked => { root.choose-data-file(); } }
        Text { x: 130px; y: 319px; text: "New"; color: #296e45; font-size: 12px; font-weight: 600; }
        TouchArea { x: 120px; y: 302px; width: 55px; height: 35px; clicked => { root.new-data-file(); } }
        Text { x: 188px; y: 319px; text: "Reset"; color: #a04a3a; font-size: 12px; font-weight: 600; }
        TouchArea { x: 178px; y: 302px; width: 62px; height: 35px; clicked => { root.delete-data-file(); } }
        AppButton { x: 24px; y: 350px; width: 232px; label: "Evaluation  ›"; primary: true; clicked => { root.open-evaluation(); } }
    }

    // Evaluation
    if root.page == Page.evaluation : Rectangle {
        y: 48px; height: parent.height - self.y; width: parent.width;
        Text { x: 24px; y: 23px; text: "Evaluation"; color: #14241a; font-size: 18px; font-weight: 700; }
        HorizontalBox { x: 24px; y: 59px; spacing: 6px;
            for option in [ { label: "Day", value: Range.day }, { label: "Week", value: Range.week }, { label: "Month", value: Range.month }, { label: "Year", value: Range.year } ] : Rectangle {
                width: 52px; height: 30px; border-radius: 16px; background: root.range == option.value ? #296e45 : #fffffc; border-width: root.range == option.value ? 0px : 1px; border-color: #d6e0d4;
                Text { text: option.label; color: root.range == option.value ? #ffffff : #526654; font-size: 10px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { root.choose-range(option.value); } }
            }
        }
        Rectangle { x: 24px; y: 101px; width: 232px; height: 42px; border-radius: 14px; background: #e0f0de; Text { x: 18px; text: root.total; color: #14241a; font-size: 12px; font-weight: 700; vertical-alignment: center; } }
        VerticalBox { x: 24px; y: 159px; width: 232px; spacing: 6px;
            for entry in root.sessions : Rectangle { height: 46px; border-radius: 12px; background: #fffffc; border-width: 1px; border-color: #d6e0d4;
                Text { x: 16px; y: 7px; text: entry.task; color: #14241a; font-size: 14px; font-weight: 700; }
                Text { x: 16px; y: 25px; text: entry.note == "" ? "No details added" : entry.note; color: #526654; font-size: 12px; }
                Text { x: 163px; y: 15px; width: 52px; text: entry.duration; color: #296e45; font-size: 13px; font-weight: 700; horizontal-alignment: right; }
            }
        }
        AppButton { x: 24px; y: 345px; width: 232px; height: 44px; label: "Export Markdown"; primary: true; clicked => { root.export-markdown(); } }
    }

    if root.task-dialog-open : Rectangle {
        width: parent.width; height: parent.height; background: #14241a88;
        Rectangle { x: 20px; y: 145px; width: 240px; height: 170px; border-radius: 18px; background: #fffffc;
            Text { x: 20px; y: 20px; text: root.rename-mode ? "Rename task" : "Add task"; color: #14241a; font-size: 18px; font-weight: 700; }
            Rectangle { x: 20px; y: 58px; width: 200px; height: 38px; border-radius: 10px; background: #edf5eb; border-width: 1px; border-color: #c9d6c7;
                LineEdit { x: 10px; width: parent.width - 20px; height: parent.height; text <=> root.task-draft; font-size: 14px; }
            }
            AppButton { x: 20px; y: 112px; width: 92px; height: 38px; label: "Cancel"; clicked => { root.close-task-dialog(); } }
            AppButton { x: 128px; y: 112px; width: 92px; height: 38px; label: "Save"; primary: true; clicked => { root.save-task(root.task-draft); } }
        }
    }

    Text { x: 12px; y: parent.height - 20px; width: parent.width - 24px; text: root.status; color: #526654; font-size: 10px; horizontal-alignment: center; }
}
