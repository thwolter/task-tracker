import {
    AppActions,
    EvaluationState,
    EvaluationTasksState,
    HomeState,
    Page,
    ProjectItem,
    Range,
    ProjectDialogState,
    Status,
    StatusKind,
    TrackingState,
} from "models.slint";
export { AppActions } from "models.slint";
import { ProjectDialog } from "views/project-dialog.slint";
import { HomeView } from "views/home.slint";
import { TrackingView } from "views/tracking.slint";
import { NoteView } from "views/note.slint";
import { SettingsView } from "views/settings.slint";
import { EvaluationView } from "views/evaluation.slint";
import { Theme } from "theme.slint";
import { StatusText } from "components/status-text.slint";
import { DrilldownView } from "views/drilldown.slint";

export component AppWindow inherits Window {
    title: "Tempo" + (tracking.paused ? " · " + @tr("paused") : "");
    width: 280px;
    preferred-height: 460px;
    min-height: 400px;
    background: Theme.palette.window-background;

    in-out property <Page> page: Page.home;
    in property <HomeState> home;
    in property <[ProjectItem]> project-settings;
    in property <TrackingState> tracking;
    in property <EvaluationState> evaluation;
    in property <EvaluationTasksState> drilldown;
    in property <ProjectDialogState> project-dialog;
    in property <Status> status: { message: "", kind: StatusKind.success };

    callback open-settings();
    callback skip-note();
    callback open-evaluation();
    callback open-home-view();

    open-settings => { root.page = Page.settings; }
    open-evaluation => { root.page = Page.evaluation; }
    open-home-view => { root.page = Page.home; }
    skip-note => { root.page = Page.home; }

    Timer {
        interval: 1s;
        running: true;
        triggered() => { AppActions.tick(); }
    }

    VerticalLayout {
        spacing: 0px;

        content := Rectangle {
            vertical-stretch: 1;

            if root.page == Page.project-editor: ProjectDialog {
                width: 100%;
                height: 100%;
                rename-mode: root.project-dialog.rename-mode;
                initial-draft: root.project-dialog.initial-draft;
                project-id: root.project-dialog.project-id;
                archived: root.project-dialog.archived;
            }
            if root.page == Page.home: HomeView {
                width: 100%;
                height: 100%;
                state: root.home;
                open-settings => { root.open-settings(); }
                open-evaluation => { root.open-evaluation(); }
            }
            if root.page == Page.tracking: TrackingView {
                width: 100%;
                height: 100%;
                state: root.tracking;
            }
            if root.page == Page.note: NoteView {
                width: 100%;
                height: 100%;
                last-task: root.home.last-task;
                skip => { root.skip-note(); }
            }
            if root.page == Page.settings: SettingsView {
                width: 100%;
                height: 100%;
                projects: root.project-settings;
                open-home-view => { root.open-home-view(); }
            }
            if root.page == Page.evaluation: EvaluationView {
                width: 100%;
                height: 100%;
                state: root.evaluation;
                open-home-view => { root.open-home-view(); }
            }
            if root.page == Page.drilldown: DrilldownView {
                width: 100%;
                height: 100%;
                state: root.drilldown;
                open-evaluation-view => { root.open-evaluation(); }
            }
        }

		if root.status.message != "": StatusText {
            status: root.status;
        }
    }
}
