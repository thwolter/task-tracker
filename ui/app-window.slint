import {
    EvaluationState,
    EvaluationTasksState,
    AdjustTimeState,
    ExportState,
    HomeState,
    FirstRunState,
    Page,
    ProjectSettingsState,
    ProjectEditorState,
    Range,
    Status,
    StatusKind,
    TrackingState,
} from "models.slint";
import { AppActions } from "actions.slint";
export { AppActions, UiCommand, UiCommandKind } from "actions.slint";
import { NativeMenuStrings } from "native-menu.slint";
export { NativeMenuStrings } from "native-menu.slint";
import { HomeView } from "views/home.slint";
import { FirstRunView } from "views/first-run.slint";
import { TrackingView } from "views/tracking.slint";
import { NoteView } from "views/note.slint";
import { AdjustTimeView } from "views/adjust-time.slint";
import { SettingsView } from "views/settings.slint";
import { ProjectEditor } from "views/project-editor.slint";
import { EvaluationView } from "views/evaluation.slint";
import { Theme } from "theme.slint";
import { StatusText } from "components/status-text.slint";
import { DrilldownView } from "views/drilldown.slint";
import { ExportView } from "views/export.slint";

export component AppWindow inherits Window {
    title: tracking.paused ? tracking.active-task + " · " + @tr("paused") : "Tempo";
    width: 280px;
    preferred-height: 460px;
    min-height: 400px;
    background: Theme.surface-canvas;

    in property <Page> current-page: Page.home;
    in property <HomeState> home-state;
    in-out property <FirstRunState> first-run;
    in property <ProjectSettingsState> project-settings;
    in-out property <ProjectEditorState> project-editor;
    in property <TrackingState> tracking;
    in property <EvaluationState> evaluation;
    in property <EvaluationTasksState> evaluation-drilldown;
    in property <ExportState> export-state;
    in property <Status> transient-status: { message: "", kind: StatusKind.success };
    in property <int> note-focus-request: 0;
    in-out property <AdjustTimeState> adjust-time;
    in property <int> adjust-time-focus-request: 0;

    Timer {
        interval: 1s;
        running: true;
        triggered() => { AppActions.tick(); }
    }

    VerticalLayout {
        spacing: 0px;

        page-content := Rectangle {
            vertical-stretch: 1;

            if root.current-page == Page.home: HomeView {
                state: root.home-state;
                tracker: root.tracking;
            }
            if root.current-page == Page.first-run: FirstRunView {
                state <=> root.first-run;
            }
            if root.current-page == Page.tracking: TrackingView {
                state: root.tracking;
            }
            if root.current-page == Page.note: note-view := NoteView {
                last-task: root.home-state.last-task;
                focus-request: root.note-focus-request;
            }
            if root.current-page == Page.adjust-time: AdjustTimeView {
                state <=> root.adjust-time;
                focus-request: root.adjust-time-focus-request;
            }
            if root.current-page == Page.settings: SettingsView {
                projects: root.project-settings;
            }
            if root.current-page == Page.project-editor: ProjectEditor {
                state <=> root.project-editor;
            }
            if root.current-page == Page.evaluation: EvaluationView {
                state: root.evaluation;
            }
            if root.current-page == Page.drilldown: DrilldownView {
                state: root.evaluation-drilldown;
            }
            if root.current-page == Page.exportpage: ExportView {
                state: root.export-state;
            }
        }
    }

    if root.transient-status.message != "": StatusText {
        width: parent.width;
        y: parent.height - self.height;
        status: root.transient-status;
    }
}
