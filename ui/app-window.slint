import {
    EvaluationState,
    HomeState,
    Page,
    Range,
    TaskDialogState,
    TrackingState,
} from "models.slint";
import { TaskDialog } from "components/task-dialog.slint";
import { HomeView } from "views/home.slint";
import { TrackingView } from "views/tracking.slint";
import { NoteView } from "views/note.slint";
import { SettingsView } from "views/settings.slint";
import { EvaluationView } from "views/evaluation.slint";
import { Theme } from "theme.slint";
import { StatusText } from "components/status-text.slint";

export component AppWindow inherits Window {
    title: "Tempo";
    width: 280px;
    height: 460px;
    background: Theme.palette.window-background;

    in-out property <Page> page: Page.home;
    in property <HomeState> home;
    in property <TrackingState> tracking;
    in property <EvaluationState> evaluation;
    in property <TaskDialogState> task-dialog;
    in property <string> status: "";

    callback start-task(string);
    callback open-settings();
    callback open-last-session();
    callback end-task();
    callback save-note(string);
    callback skip-note();
    callback open-evaluation();
    callback choose-range(Range);
    callback open-add-task();
    callback open-rename-task(string);
    callback save-task(string);
    callback close-task-dialog();
    callback open-home-view();
    callback export-markdown();

    open-settings => { root.page = Page.settings; }
    open-evaluation => { root.page = Page.evaluation; }
    open-home-view => { root.page = Page.home; }

    if root.page == Page.home: HomeView {
        state: root.home;
        start-task(id) => { root.start-task(id); }
        open-settings => { root.open-settings(); }
        open-last-session => { root.open-last-session(); }
    }
    if root.page == Page.tracking: TrackingView {
        state: root.tracking;
        end-task => { root.end-task(); }
    }
    if root.page == Page.note: NoteView {
        last-session: root.home.last-session;
        save-note(note) => { root.save-note(note); }
        skip => { root.skip-note(); }
    }
    if root.page == Page.settings: SettingsView {
        tasks: root.home.tasks;
        open-evaluation => { root.open-evaluation(); }
        open-add-task => { root.open-add-task(); }
        open-rename-task(id) => { root.open-rename-task(id); }
        open-home-view => { root.open-home-view(); }
    }
    if root.page == Page.evaluation: EvaluationView {
        y: 48px;
        height: parent.height - self.y;
        width: parent.width;
        state: root.evaluation;
        choose-range(value) => { root.choose-range(value); }
        export-markdown => { root.export-markdown(); }
    }
    if root.task-dialog.open: TaskDialog {
        width: parent.width;
        height: parent.height;
        rename-mode: root.task-dialog.rename-mode;
        initial-draft: root.task-dialog.initial-draft;
        close => { root.close-task-dialog(); }
        save(task) => { root.save-task(task); }
    }

    StatusText {
        host-height: parent.height;
        host-width: parent.width;
        status: root.status;
    }
}
