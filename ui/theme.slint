import { Palette } from "std-widgets.slint";

export struct Font {
    size: length,
    weight: float,
    letter-spacing: length,
}

export struct Typo {
    heading: Font,
    title: Font,
    body: Font,
    body-strong: Font,
    body-link: Font,
    supporting: Font,
    label: Font,
    small-label: Font,
    caption: Font,
    timer: Font,
}

export struct Border {
    radius: length,
    width: length,
}

export struct Shadow {
    offset-x: length,
    offset-y: length,
    blur: length,
    color: color,
}

export global Theme {
    // The system palette updates when the operating system changes appearance.
    // Unknown resolves to the existing light scheme.
    private property <bool> dark-mode: Palette.color-scheme == ColorScheme.dark;

    // Private foundation tokens retain the established light values. Components
    // consume only the semantic roles below.
    private property <color> sage-canvas: #f6f8f6;
    private property <color> sage-card: #fffffc;
    private property <color> sage-subtle: #e0f0de;
    private property <color> sage-input: #edf5eb;
    private property <color> neutral-disabled: #e6e9e5;
    private property <color> neutral-archived: #d9ded9;
    private property <color> ink-primary: #14241a;
    private property <color> ink-secondary: #526654;
    private property <color> ink-muted: #5e725f;
    private property <color> ink-disabled: #647566;
    private property <color> ink-on-accent: #fffffc;
    private property <color> green-primary: #296e45;
    private property <color> green-focus: #3f7f5a;
    private property <color> green-timer: #d6f0d6;
    private property <color> red-danger: #9b3f33;
    private property <color> red-danger-surface: #fbece8;
    private property <color> border-default-color: #c9d8c7;
    private property <color> border-subtle-color: #d4e0d2;
    private property <color> border-divider-color: #cbd8c9;

    // Surface roles
    in-out property <color> surface-canvas: dark-mode ? #121b15 : sage-canvas;
    in-out property <color> surface-card: dark-mode ? #1d2b21 : sage-card;
    in-out property <color> surface-input: dark-mode ? #283a2d : sage-input;
    in-out property <color> surface-subtle: dark-mode ? #294331 : sage-subtle;
    in-out property <color> surface-archived: dark-mode ? #344138 : neutral-archived;
    in-out property <color> surface-disabled: dark-mode ? #2b372f : neutral-disabled;
    in-out property <color> surface-danger: dark-mode ? #432b29 : red-danger-surface;

    // Content and structural roles
    in-out property <color> content-primary: dark-mode ? #f1f7ef : ink-primary;
    in-out property <color> content-secondary: dark-mode ? #c0d1bf : ink-secondary;
    in-out property <color> content-muted: dark-mode ? #a9bda9 : ink-muted;
    in-out property <color> content-disabled: dark-mode ? #a2b4a3 : ink-disabled;
    in-out property <color> content-on-accent: dark-mode ? #102218 : ink-on-accent;
    in-out property <color> content-on-primary-hover: dark-mode ? #102218 : ink-on-accent;
    in-out property <color> content-on-primary-pressed: dark-mode ? #102218 : ink-on-accent;
    in-out property <color> action-primary: dark-mode ? #78ce98 : green-primary;
    in-out property <color> action-danger: dark-mode ? #e8968c : red-danger;
    in-out property <color> action-danger-hover: dark-mode ? #f0aaa0 : #873529;
    in-out property <color> action-danger-pressed: dark-mode ? #d78177 : #702b22;
    in-out property <color> action-danger-outline-pressed: dark-mode ? #593532 : #f3d6d0;
    in-out property <color> border-default: dark-mode ? #4c6351 : border-default-color;
    in-out property <color> border-subtle: dark-mode ? #3e5444 : border-subtle-color;
    in-out property <color> border-divider: dark-mode ? #435a49 : border-divider-color;
    in-out property <color> border-focus: dark-mode ? #a7eab5 : green-focus;
    in-out property <color> timer-ring: dark-mode ? #3b6548 : green-timer;

    // Opaque interaction colors keep the same contrast on every surface.
    in-out property <color> action-primary-hover: dark-mode ? #8ddca9 : #245f3d;
    in-out property <color> action-primary-pressed: dark-mode ? #62bb83 : #1f5134;
    in-out property <color> action-secondary: dark-mode ? #345c40 : sage-subtle;
    in-out property <color> action-secondary-hover: dark-mode ? #40704d : #d4e8d1;
    in-out property <color> action-secondary-pressed: dark-mode ? #2c5138 : #c8dec5;
    in-out property <color> action-icon: dark-mode ? #345c40 : sage-subtle;
    in-out property <color> action-icon-hover: dark-mode ? #40704d : #d4e8d1;
    in-out property <color> action-icon-pressed: dark-mode ? #2c5138 : #c8dec5;
    in-out property <color> action-card-hover: dark-mode ? #293e30 : sage-input;
    in-out property <color> action-card-pressed: dark-mode ? #34513c : sage-subtle;
    in-out property <color> content-link: dark-mode ? #91dfaa : green-primary;
    in-out property <color> content-link-hover: dark-mode ? #aaf0bf : #245f3d;
    in-out property <color> content-link-pressed: dark-mode ? #7dcc98 : #1f5134;
    in-out property <color> dialog-backdrop: dark-mode ? #080f0bd9 : #14241a80;

    in property <Typo> typography: {
        heading: { size: 20px, weight: 700, letter-spacing: 0px },
        title: { size: 18px, weight: 700, letter-spacing: 0px },
        body: { size: 15px, weight: 400, letter-spacing: 0px },
        body-strong: { size: 15px, weight: 600, letter-spacing: 0px },
        body-link: { size: 15px, weight: 500, letter-spacing: 0px },
        supporting: { size: 14px, weight: 500, letter-spacing: 0px },
        label: { size: 13px, weight: 600, letter-spacing: 0px },
        small-label: { size: 12px, weight: 600, letter-spacing: 0.4px },
        caption: { size: 12px, weight: 500, letter-spacing: 0px },
        timer: { size: 32px, weight: 700, letter-spacing: 0px },
    };
    in property <Border> border: {
        radius: 8px,
        width: 1px,
    };
    in property <Shadow> dialog-shadow: {
        offset-x: 0px,
        offset-y: 4px,
        blur: dark-mode ? 12px : 6px,
        color: dark-mode ? #050b0770 : #14241a1a,
    };
}
