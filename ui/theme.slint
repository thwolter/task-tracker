
export struct Palette {
    window-background: color,
    surface: color,
    soft-surface: color,
    accent-surface: color,
    accent: color,
    on-accent: color,
    timer-ring: color,
    text: color,
    muted-text: color,
    secondary-text: color,
    border: color,
    soft-border: color,
    section-divider: color,
    archived-surface: color,
    disabled-surface: color,
    danger: color,
}

export struct Font { size: length, weight: float }

export struct Typo {
    display: Font,
    heading: Font,
    title: Font,
    body: Font,
    body-strong: Font,
    supporting: Font,
    label: Font,
    small-label: Font,
    caption: Font,
    marker: Font,
    timer: Font,
}

export struct Border {
    radius: length,
    width: length,
}

export global Theme {
    in property <Palette> palette: {
        window-background: #f6f8f6,
        surface: #fffffc,
        soft-surface: #edf5eb,
        accent-surface: #e0f0de,
        accent: #296e45,
        on-accent: #ffffff,
        timer-ring: #d6f0d6,
        text: #14241a,
        muted-text: #526654,
        secondary-text: #637d66,
        border: #d6e0d4,
        soft-border: #c9d6c7,
        section-divider: #c7d6c4,
        archived-surface: #d6d9de,
        disabled-surface: #e7ece6,
        danger: #ad3b2b,
    };
    in property <Typo> typography: {
        display: { size: 21px, weight: 700 },
        heading: { size: 20px, weight: 700 },
        title: { size: 18px, weight: 700 },
        body: { size: 15px, weight: 400 },
        body-strong: { size: 15px, weight: 700 },
        supporting: { size: 13px, weight: 600 },
        label: { size: 12px, weight: 500 },
        small-label: { size: 11px, weight: 600 },
        caption: { size: 10px, weight: 500 },
        timer: { size: 32px, weight: 700 },
        marker: { size: 22px, weight: 400 },
    };
    in property <Border> border: {
        radius: 10px,
        width: 1px,
    };
}
