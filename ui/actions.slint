import { Range } from "models.slint";

export enum UiCommandKind {
    tick,
    start-tracking,
    open-last-task,
    end-tracking,
    toggle-tracking-pause,
    save-task-note,
    update-evaluation-task,
    delete-evaluation-task,
    choose-range,
    open-add-project,
    open-rename-project,
    save-project,
    close-project-dialog,
    archive-project,
    unarchive-project,
    delete-project,
    export-markdown,
    open-drilldown,
}

export struct UiCommand {
    kind: UiCommandKind,
    id: string,
    text: string,
    range: Range,
}

export global AppActions {
    callback dispatch(UiCommand);

    callback tick();
    callback start-tracking(string);
    callback open-last-task();
    callback end-tracking();
    callback toggle-tracking-pause();
    callback save-task-note(string);
    callback update-evaluation-task(string, string);
    callback delete-evaluation-task(string);
    callback choose-range(Range);
    callback open-add-project();
    callback open-rename-project(string);
    callback save-project(string);
    callback close-project-dialog();
    callback archive-project(string);
    callback unarchive-project(string);
    callback delete-project(string);
    callback export-markdown();
    callback open-drilldown(string);

    tick => { dispatch({ kind: UiCommandKind.tick, id: "", text: "", range: Range.day }); }
    start-tracking(id) => { dispatch({ kind: UiCommandKind.start-tracking, id: id, text: "", range: Range.day }); }
    open-last-task => { dispatch({ kind: UiCommandKind.open-last-task, id: "", text: "", range: Range.day }); }
    end-tracking => { dispatch({ kind: UiCommandKind.end-tracking, id: "", text: "", range: Range.day }); }
    toggle-tracking-pause => { dispatch({ kind: UiCommandKind.toggle-tracking-pause, id: "", text: "", range: Range.day }); }
    save-task-note(note) => { dispatch({ kind: UiCommandKind.save-task-note, id: "", text: note, range: Range.day }); }
    update-evaluation-task(id, note) => { dispatch({ kind: UiCommandKind.update-evaluation-task, id: id, text: note, range: Range.day }); }
    delete-evaluation-task(id) => { dispatch({ kind: UiCommandKind.delete-evaluation-task, id: id, text: "", range: Range.day }); }
    choose-range(range) => { dispatch({ kind: UiCommandKind.choose-range, id: "", text: "", range: range }); }
    open-add-project => { dispatch({ kind: UiCommandKind.open-add-project, id: "", text: "", range: Range.day }); }
    open-rename-project(id) => { dispatch({ kind: UiCommandKind.open-rename-project, id: id, text: "", range: Range.day }); }
    save-project(name) => { dispatch({ kind: UiCommandKind.save-project, id: "", text: name, range: Range.day }); }
    close-project-dialog => { dispatch({ kind: UiCommandKind.close-project-dialog, id: "", text: "", range: Range.day }); }
    archive-project(id) => { dispatch({ kind: UiCommandKind.archive-project, id: id, text: "", range: Range.day }); }
    unarchive-project(id) => { dispatch({ kind: UiCommandKind.unarchive-project, id: id, text: "", range: Range.day }); }
    delete-project(id) => { dispatch({ kind: UiCommandKind.delete-project, id: id, text: "", range: Range.day }); }
    export-markdown => { dispatch({ kind: UiCommandKind.export-markdown, id: "", text: "", range: Range.day }); }
    open-drilldown(id) => { dispatch({ kind: UiCommandKind.open-drilldown, id: id, text: "", range: Range.day }); }
}
