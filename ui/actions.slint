import { ExportFormat, Page, Range } from "models.slint";

export enum UiCommandKind {
    tick,
    navigate,
    start-tracking,
    open-last-task,
    end-tracking,
    toggle-tracking-pause,
    save-task-note,
    update-evaluation-task,
    delete-evaluation-task,
    choose-range,

    open-project-create,
    open-project-edit,
    add-project,
    add-first-run-project,
    save-project,
    archive-project,
    unarchive-project,
    delete-project,

    open-export,
    export-report,
    open-drilldown,
    backup-data,
    restore-data,
    show-keyboard-shortcuts
}

export struct UiCommand {
    kind: UiCommandKind,
    page: Page,
    id: string,
    text: string,
    range: Range,
    export-format: ExportFormat,
}

export global AppActions {
    callback dispatch(UiCommand);

    callback tick();
    callback navigate(Page);
    callback start-tracking(string);
    callback open-last-task();
    callback end-tracking();
    callback toggle-tracking-pause();
    callback save-task-note(string);
    callback update-evaluation-task(string, string);
    callback delete-evaluation-task(string);
    callback choose-range(Range);

    callback open-project-create();
    callback open-project-edit(string);
    callback add-project(string);
    callback project-name-exists(string) -> bool;
    callback add-first-run-project(string);
    callback save-project(string, string);
    callback archive-project(string);
    callback unarchive-project(string);
    callback delete-project(string);

    callback open-export();
    callback export-report(ExportFormat);
    callback open-drilldown(string);
    callback backup-data();
    callback restore-data();
    callback show-keyboard-shortcuts();

    tick => { dispatch({ kind: UiCommandKind.tick }); }
    navigate(page) => { dispatch({ kind: UiCommandKind.navigate, page: page }); }
    start-tracking(id) => { dispatch({ kind: UiCommandKind.start-tracking, id: id }); }
    open-last-task => { dispatch({ kind: UiCommandKind.open-last-task }); }
    end-tracking => { dispatch({ kind: UiCommandKind.end-tracking }); }
    toggle-tracking-pause => { dispatch({ kind: UiCommandKind.toggle-tracking-pause }); }

    save-task-note(note) => { dispatch({ kind: UiCommandKind.save-task-note, text: note }); }

    update-evaluation-task(id, note) => { dispatch({ kind: UiCommandKind.update-evaluation-task, id: id, text: note }); }
    delete-evaluation-task(id) => { dispatch({ kind: UiCommandKind.delete-evaluation-task, id: id }); }

    choose-range(range) => { dispatch({ kind: UiCommandKind.choose-range, range: range }); }

    open-project-create => { dispatch({ kind: UiCommandKind.open-project-create }); }
    open-project-edit(id) => { dispatch({ kind: UiCommandKind.open-project-edit, id: id }); }
    add-project(name) => { dispatch({ kind: UiCommandKind.add-project, text: name }); }
    add-first-run-project(name) => { dispatch({ kind: UiCommandKind.add-first-run-project, text: name }); }
    save-project(id, name) => { dispatch({ kind: UiCommandKind.save-project, id: id, text: name }); }
    archive-project(id) => { dispatch({ kind: UiCommandKind.archive-project, id: id }); }
    unarchive-project(id) => { dispatch({ kind: UiCommandKind.unarchive-project, id: id }); }
    delete-project(id) => { dispatch({ kind: UiCommandKind.delete-project, id: id }); }

    open-export => { dispatch({ kind: UiCommandKind.open-export }); }
    export-report(format) => { dispatch({ kind: UiCommandKind.export-report, export-format: format }); }
    open-drilldown(id) => { dispatch({ kind: UiCommandKind.open-drilldown, id: id }); }
    backup-data => { dispatch({ kind: UiCommandKind.backup-data }); }
    restore-data => { dispatch({ kind: UiCommandKind.restore-data }); }
    show-keyboard-shortcuts => { dispatch({ kind: UiCommandKind.show-keyboard-shortcuts }); }
}
